+// include/strata/spec/frozen_costs.hpp - H-FC: tabella s(T) fissa per DraftPolicy (STRATA_SPEC_COST_FROZEN=<path>).
+//
+// Il file contiene 3 liste separate da ';' (bucket di contesto < 6K, < 24K, oltre), ciascuna con i ms per round delle
+// finestre T1,T2,..,Tn separati da ',': lo stesso formato di STRATA_SPEC_COST_TABLE (generate.cpp), letto con lo stesso
+// parser (atof, al piu' kMaxT valori per lista, liste oltre la terza ignorate).  Diversamente da COST_TABLE:
+//   * mancano bucket (meno di 3 liste) o un T in 1..min(S, kMaxT) di un bucket e' assente o <= 0  ->  errore all'avvio;
+//     nessun riempimento e nessuna copia dai bucket vicini (Addendum A della specifica H-FC);
+//   * ogni T presente sovrascrive il costo della policy con n = 1000 (set_costs) e la policy viene congelata (set_frozen).
+// Header-only, cosi' lo usano sia generate.cpp (CLI e serve) sia il test di DraftPolicy senza nuovi target CMake.
+#pragma once
+
+#include "strata/spec/draft_policy.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace strata::spec {
+
+/// SHA-256 (FIPS 180-4) di un buffer, in esadecimale minuscolo: identifica il file della tabella nei metadati del run.
+inline std::string frozen_sha256_hex(const std::string& data) {
+    static constexpr uint32_t k[64] = {
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01,
+        0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+        0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08,
+        0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+    uint32_t h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+    std::string m = data;
+    const uint64_t bits = (uint64_t) data.size() * 8u;
+    m.push_back((char) 0x80);
+    while (m.size() % 64 != 56) m.push_back('\0');
+    for (int i = 7; i >= 0; --i) m.push_back((char) ((bits >> (8 * i)) & 0xff));
+    auto rotr = [](uint32_t x, int n) { return (x >> n) | (x << (32 - n)); };
+    for (size_t off = 0; off < m.size(); off += 64) {
+        uint32_t w[64];
+        for (int i = 0; i < 16; ++i)
+            w[i] = (uint32_t) (unsigned char) m[off + 4 * i] << 24 | (uint32_t) (unsigned char) m[off + 4 * i + 1] << 16 |
+                   (uint32_t) (unsigned char) m[off + 4 * i + 2] << 8 | (uint32_t) (unsigned char) m[off + 4 * i + 3];
+        for (int i = 16; i < 64; ++i) {
+            const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+        for (int i = 0; i < 64; ++i) {
+            const uint32_t t1 = hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+            const uint32_t t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+        }
+        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+    }
+    char out[65];
+    for (int i = 0; i < 8; ++i) std::snprintf(out + 8 * i, 9, "%08x", h[i]);
+    return std::string(out, 64);
+}
+
+/// H-FC v2: la tabella letta e validata, non ancora applicata a una policy.  generate.cpp la legge all'avvio, PRIMA del
+/// caricamento del modello (un file sbagliato esce con rc=1 senza caricare nulla), e la applica alla policy dove la v1
+/// la leggeva (apply_frozen_costs).
+struct FrozenCosts {
+    double ms[DraftPolicy::kCtxBuckets][DraftPolicy::kMaxT] = {};
+    int n[DraftPolicy::kCtxBuckets] = {};
+    int S = 0;              ///< il --spec con cui e' stata validata (T1..min(S, kMaxT) presenti in ogni bucket)
+    bool loaded = false;    ///< true solo dopo una validazione riuscita
+    std::string path, sha_hex;
+};
+
+/// Valida la tabella gia' letta contro `S`: false + `err` se manca un bucket o un T in 1..min(S, kMaxT) e' assente o <= 0.
+inline bool validate_frozen_costs(const FrozenCosts& fc, int nb, int S, std::string& err) {
+    constexpr int kM = DraftPolicy::kMaxT, kB = DraftPolicy::kCtxBuckets;
+    if (nb < kB) {   // Addendum A: niente riempimento dei bucket mancanti
+        err = "STRATA_SPEC_COST_FROZEN: la tabella ha " + std::to_string(nb) + " bucket su " + std::to_string(kB) +
+              " (servono 3 liste separate da ';': ctx<6K;ctx<24K;ctx>=24K)";
+        return false;
+    }
+    const int s = std::clamp(S, 1, kM);
+    for (int b = 0; b < kB; ++b)
+        for (int t = 1; t <= s; ++t)
+            if (t > fc.n[b] || fc.ms[b][t - 1] <= 0.0) {
+                err = "STRATA_SPEC_COST_FROZEN: il bucket " + std::to_string(b) + " non ha T" + std::to_string(t) +
+                      " (servono T1..T" + std::to_string(s) + " > 0 per --spec " + std::to_string(S) + ")";
+                return false;
+            }
+    return true;
+}
+
+/// Interpreta il testo della tabella (vedi in testa al file) in `out` e lo valida contro `S`.  false + `err` se
+/// incompleto: `out.loaded` resta false.
+inline bool parse_frozen_costs_text(const std::string& text, int S, FrozenCosts& out, std::string& err) {
+    constexpr int kM = DraftPolicy::kMaxT, kB = DraftPolicy::kCtxBuckets;
+    FrozenCosts fc;
+    int nb = 0;
+    // lo stesso ciclo del parser di STRATA_SPEC_COST_TABLE (generate.cpp, CLI), con una riga per bucket invece del seed
+    for (const char* q = text.c_str(); *q != '\0' && nb < kB;) {
+        if (fc.n[nb] < kM) fc.ms[nb][fc.n[nb]++] = std::atof(q);
+        while (*q != '\0' && *q != ',' && *q != ';') ++q;
+        const bool end_list = *q == ';' || *q == '\0';
+        if (*q != '\0') ++q;
+        if (end_list) ++nb;
+    }
+    if (!validate_frozen_costs(fc, nb, S, err)) return false;
+    fc.S = S;
+    fc.loaded = true;
+    fc.path = out.path;
+    fc.sha_hex = out.sha_hex;
+    out = fc;
+    return true;
+}
+
+/// Applica una tabella gia' validata: la ri-valida contro lo `S` in vigore ora (che puo' solo essere sceso, es. il cap
+/// di --draft dflash2), la scrive nella policy e la congela.  false + `err` (policy intatta) se non e' caricata o se
+/// non copre `S`.
+inline bool apply_frozen_costs(DraftPolicy& policy, const FrozenCosts& fc, int S, std::string& err) {
+    constexpr int kB = DraftPolicy::kCtxBuckets;
+    if (!fc.loaded) {
+        err = "STRATA_SPEC_COST_FROZEN: tabella non caricata";
+        return false;
+    }
+    if (!validate_frozen_costs(fc, kB, S, err)) return false;
+    for (int b = 0; b < kB; ++b) policy.set_costs(fc.ms[b], fc.n[b], b);
+    policy.set_frozen(true);
+    return true;
+}
+
+/// Interpreta il testo della tabella e, solo se e' completo, lo scrive nella policy e la congela (parse + apply).
+/// `S` = --spec (le larghezze 1..min(S, kMaxT) devono esserci in tutti e 3 i bucket).  false + `err` se incompleto:
+/// in quel caso la policy non viene toccata.
+inline bool apply_frozen_costs_text(DraftPolicy& policy, const std::string& text, int S, std::string& err) {
+    FrozenCosts fc;
+    return parse_frozen_costs_text(text, S, fc, err) && apply_frozen_costs(policy, fc, S, err);
+}
+
+/// Legge il file `path`, ne calcola lo sha256 e lo valida in `out` (path e sha_hex compilati anche se non valido).
+inline bool load_frozen_costs_file(const char* path, int S, FrozenCosts& out, std::string& err) {
+    out = FrozenCosts{};
+    out.path = path;
+    std::ifstream f(path, std::ios::binary);
+    if (!f) {
+        err = std::string("STRATA_SPEC_COST_FROZEN: impossibile aprire ") + path;
+        return false;
+    }
+    std::ostringstream ss;
+    ss << f.rdbuf();
+    if (f.bad()) {
+        err = std::string("STRATA_SPEC_COST_FROZEN: errore di lettura di ") + path;
+        return false;
+    }
+    const std::string text = ss.str();
+    out.sha_hex = frozen_sha256_hex(text);
+    return parse_frozen_costs_text(text, S, out, err);
+}
+
+/// Legge il file `path`, ne calcola lo sha256 (in `sha_hex`) e applica la tabella (load + apply).
+inline bool load_frozen_costs_file(DraftPolicy& policy, const char* path, int S, std::string& sha_hex, std::string& err) {
+    FrozenCosts fc;
+    const bool ok = load_frozen_costs_file(path, S, fc, err);
+    sha_hex = fc.sha_hex;
+    return ok && apply_frozen_costs(policy, fc, S, err);
+}
+
+}  // namespace strata::spec
