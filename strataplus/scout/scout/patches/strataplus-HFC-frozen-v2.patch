diff --git a/src/spec/draft_policy_frozen_test.cpp b/src/spec/draft_policy_frozen_test.cpp
new file mode 100644
index 0000000..b3db3a2
--- /dev/null
+++ b/src/spec/draft_policy_frozen_test.cpp
@@ -0,0 +1,194 @@
+// src/spec/draft_policy_frozen_test.cpp - H-FC: DraftPolicy con la tabella dei costi congelata (STRATA_SPEC_COST_FROZEN).
+//
+// Verifica, senza modello e senza GPU, che
+//   1. con frozen spento i costi seguono l'EMA come in 7dd5cf1 (la tabella si muove; stale() rilancia i probe);
+//   2. con frozen acceso e set_costs, molti observe/observe_chain con round_ms > 0 non muovono la tabella, last_ si
+//      aggiorna (verificato sbloccando il flag dopo), stale() e' falso e non partono probe; l'acceptance impara ancora;
+//   3. set_context con frozen cambia solo il bucket, senza copiare tra bucket;
+//   4. il loader del file (apply_frozen_costs_text / load_frozen_costs_file) rifiuta bucket o T mancanti e lascia la
+//      policy intatta; lo sha256 coincide con i vettori noti.
+#include "strata/spec/draft_policy.hpp"
+#include "strata/spec/frozen_costs.hpp"
+
+#include <cstdio>
+#include <string>
+
+using strata::spec::DraftPolicy;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const char* what) {
+    std::printf("  %-74s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+// costi per round (ms) T1..T8 dei 3 bucket: le finestre larghe costano molto, cosi' un lookup sceglie T4 e non T6
+const double kTab[3][8] = {{10, 12, 14, 16, 40, 80, 90, 100}, {11, 13, 15, 17, 41, 81, 91, 101}, {12, 14, 16, 18, 42, 82, 92, 102}};
+void freeze(DraftPolicy& p) {
+    for (int b = 0; b < 3; ++b) p.set_costs(kTab[b], 8, b);
+    p.set_frozen(true);
+}
+// round MTP (lookup=false) di larghezza t: non toccano ok_/bad_, quindi q del lookup resta al prior (0.96 per match 30)
+void mtp_rounds(DraftPolicy& p, int t, int n, double ms) {
+    for (int i = 0; i < n; ++i) p.observe(false, t, t - 1, 0, ms);
+}
+}  // namespace
+
+int main() {
+    std::printf("draft_policy_frozen_test\n");
+    // 1. frozen spento: EMA e stale come sempre
+    {
+        DraftPolicy p(6);
+        p.seed_costs(kTab[0], 8, 6.0, 0);
+        const std::string before = p.cost_table_text();
+        mtp_rounds(p, 3, 50, 99.0);
+        check(p.cost_table_text() != before && p.cost_ms(3) > 50.0, "frozen spento: l'EMA muove il costo di T3");
+        check(!p.frozen(), "frozen spento di default");
+    }
+    {   // controllo: senza frozen, 400 round su T3 rendono stale T6 e choose rilancia il probe a t_full = 6
+        DraftPolicy p(6);
+        for (int b = 0; b < 3; ++b) p.set_costs(kTab[b], 8, b);
+        check(p.choose(2, 5, 30).t == 4, "frozen spento, round 0: il lookup sceglie T4");
+        mtp_rounds(p, 3, 400, kTab[0][2]);
+        check(p.choose(2, 5, 30).t == 6, "frozen spento, dopo 400 round: T6 e' stale e viene risondata");
+        check(p.chain(2, 1.0, 4, 40) == 4, "frozen spento, dopo 400 round: chain risonda kmax (stale)");
+    }
+    // 2. frozen acceso
+    {
+        DraftPolicy p(6);
+        freeze(p);
+        const std::string before = p.cost_table_text();
+        check(p.frozen(), "set_frozen(true): frozen() e' vero");
+        check(before.find("(n=1000)") != std::string::npos && before.find("ctx>=24K:") != std::string::npos,
+              "set_costs: n=1000 in tutti e 3 i bucket");
+        const int pick0 = p.choose(2, 5, 30).t;
+        const double q0 = p.lookup_rate(4), c0 = p.chain_rate(40), d0 = p.draft_rate(0.9);
+        for (int i = 0; i < 2000; ++i) {
+            const int t = 1 + i % 6;
+            p.set_context((i % 7) * 5000);
+            p.observe(i % 3 == 0, t, i % t, 4, 5.0 + 97.0 * (i % 11));       // tempi a caso, anche enormi
+            p.observe_chain(2, 1 + i % 3, 1 + i % 4, 40, 1000.0 + i);
+        }
+        float pr[3] = {0.9f, 0.9f, 0.9f};
+        for (int i = 0; i < 50; ++i) p.observe_probs(pr, 3, 0);
+        p.set_context(0);
+        check(p.cost_table_text() == before, "frozen: 4000 observe con round_ms > 0 non muovono la tabella");
+        check(p.choose(2, 5, 30).t == pick0 && pick0 == 4, "frozen: nessun probe stale in choose (resta T4)");
+        check(p.lookup_rate(4) != q0, "frozen: l'acceptance del lookup impara ancora");
+        check(p.chain_rate(40) != c0, "frozen: l'acceptance della chain impara ancora");
+        check(p.draft_rate(0.9) != d0, "frozen: observe_probs impara ancora");
+    }
+    {   // stale() falso con frozen anche quando T6 non viene mai usata per 400 round
+        DraftPolicy p(6);
+        freeze(p);
+        mtp_rounds(p, 3, 400, 999.0);
+        check(p.choose(2, 5, 30).t == 4, "frozen, 400 round senza T6: stale() falso, niente probe a T6");
+        check(p.chain(2, 1.0, 4, 40) != 4, "frozen, 400 round senza T6: chain non risonda kmax");
+        // last_ di T6 e' fermo a 0: sbloccando, T6 diventa stale (la sensibilita' del controllo)
+        p.set_frozen(false);
+        check(p.choose(2, 5, 30).t == 6, "sbloccato dopo: T6 (mai usata) risulta stale");
+    }
+    {   // last_ si aggiorna con frozen: 400 round su T6, poi sbloccato T6 non e' stale
+        DraftPolicy p(6);
+        freeze(p);
+        const std::string before = p.cost_table_text();
+        mtp_rounds(p, 6, 400, 999.0);
+        check(p.cost_table_text() == before, "frozen, 400 round su T6 a 999 ms: il costo di T6 resta 80");
+        p.set_frozen(false);
+        check(p.choose(2, 5, 30).t == 4, "sbloccato dopo: T6 usata con frozen -> last_ aggiornato, non stale");
+    }
+    {   // keep_draft: con n=1000 nessun probe di larghezze "non misurate"
+        DraftPolicy p(6), q(6);
+        freeze(p);
+        DraftPolicy::ChainState sp, sq;
+        p.keep_draft(sp, 0, 0.18f, 6);   // a = 0.18: >= 0.15 (probe) ma (1 + a) / 12 < 1 / 10
+        q.keep_draft(sq, 0, 0.18f, 6);
+        check(sq.best_rows == 2 && sp.best_rows == 1, "keep_draft: probe su T2 senza tabella, nessuno con frozen");
+    }
+    // 3. set_context con frozen: solo cambio di bucket, senza copie
+    {
+        DraftPolicy p(8);
+        freeze(p);
+        p.set_context(10000);
+        const bool b1 = p.cost_ms(5) == kTab[1][4];
+        p.set_context(30000);
+        const bool b2 = p.cost_ms(5) == kTab[2][4];
+        p.set_context(100);
+        const bool b0 = p.cost_ms(5) == kTab[0][4];
+        check(b0 && b1 && b2, "frozen: set_context passa ai bucket 0/1/2 senza robust");
+        DraftPolicy r(8);   // frozen + robust, solo il bucket 0: il bucket 1 non viene riempito per copia
+        r.set_costs(kTab[0], 8, 0);
+        r.set_frozen(true);
+        r.set_robust(true);
+        const std::string before = r.cost_table_text();
+        r.set_context(10000);
+        check(r.cost_table_text() == before && r.cost_table_text().find("ctx<24K") == std::string::npos,
+              "frozen + robust: set_context non copia tra bucket");
+    }
+    // 4. loader
+    {
+        using strata::spec::apply_frozen_costs_text;
+        struct Bad { const char* text; int S; const char* what; };
+        const Bad bad[] = {
+            {"", 4, "loader: tabella vuota rifiutata"},
+            {"10,12,14,16", 4, "loader: 1 bucket solo rifiutato (niente copia)"},
+            {"10,12,14,16;11,13,15,17", 4, "loader: 2 bucket rifiutati"},
+            {"10,12,14,16;11,13,15,17;", 4, "loader: terzo bucket vuoto rifiutato"},
+            {"10,12,14,16;11,13,15;12,14,16,18", 4, "loader: T4 mancante nel bucket 1 rifiutato"},
+            {"10,12,14,16;11,13,0,17;12,14,16,18", 4, "loader: T3 = 0 nel bucket 1 rifiutato"},
+            {"10,,14,16;11,13,15,17;12,14,16,18", 4, "loader: campo vuoto (T2) nel bucket 0 rifiutato"},
+            {"10,12,14,16;11,13,15,17;12,14,abc,18", 4, "loader: valore non numerico rifiutato"},
+            {"10,12,14,16;11,13,15,17;12,14,16,18", 5, "loader: --spec 5 con 4 T rifiutato"},
+        };
+        for (const Bad& b : bad) {
+            DraftPolicy p(8);
+            std::string err;
+            const bool ok = apply_frozen_costs_text(p, b.text, b.S, err);
+            check(!ok && !err.empty() && !p.frozen() && p.cost_table_text().empty(), b.what);
+        }
+        DraftPolicy p(8);
+        std::string err;
+        const bool ok = apply_frozen_costs_text(p, "10,12,14,16;\n11,13,15,17;\n12,14,16,18\n", 4, err);
+        check(ok && p.frozen() && p.cost_table_text() ==
+              "ctx<6K: T1:10.00(n=1000) T2:12.00(n=1000) T3:14.00(n=1000) T4:16.00(n=1000) | ctx<24K: T1:11.00(n=1000) "
+              "T2:13.00(n=1000) T3:15.00(n=1000) T4:17.00(n=1000) | ctx>=24K: T1:12.00(n=1000) T2:14.00(n=1000) "
+              "T3:16.00(n=1000) T4:18.00(n=1000)", "loader: tabella completa (con a capo) accettata e congelata");
+        DraftPolicy f(8);
+        std::string sha, ferr;
+        check(!strata::spec::load_frozen_costs_file(f, "/nonexistent/hfc_table.txt", 4, sha, ferr) && !f.frozen(),
+              "loader: file inesistente rifiutato");
+        check(strata::spec::frozen_sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" &&
+              strata::spec::frozen_sha256_hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" &&
+              strata::spec::frozen_sha256_hex(std::string(1000, 'a')) ==
+                  "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3",
+              "sha256: vettori noti (abc, vuoto, 1000 x 'a')");
+    }
+    // 5. v2: lettura/validazione separate dall'applicazione (preload prima del modello, apply dopo)
+    {
+        using namespace strata::spec;
+        FrozenCosts fc;
+        std::string err;
+        check(!parse_frozen_costs_text("10,12,14,16;11,13,15,17", 4, fc, err) && !fc.loaded && !err.empty(),
+              "v2 parse: 2 bucket rifiutati, loaded resta false");
+        DraftPolicy p0(8);
+        err.clear();
+        check(!apply_frozen_costs(p0, fc, 4, err) && !p0.frozen() && p0.cost_table_text().empty(),
+              "v2 apply: tabella non caricata rifiutata, policy intatta");
+        err.clear();
+        check(parse_frozen_costs_text("10,12,14,16;11,13,15,17;12,14,16,18", 4, fc, err) && fc.loaded && fc.S == 4,
+              "v2 parse: tabella completa validata");
+        DraftPolicy p(8), q(8);
+        check(apply_frozen_costs(p, fc, 3, err) && p.frozen(), "v2 apply: S sceso (4 -> 3, cap dflash2) accettato");
+        std::string e2;
+        check(apply_frozen_costs_text(q, "10,12,14,16;11,13,15,17;12,14,16,18", 4, e2) &&
+              p.cost_table_text() == q.cost_table_text(), "v2 apply: stessa tabella del percorso v1 (apply_frozen_costs_text)");
+        DraftPolicy r(8);
+        err.clear();
+        check(!apply_frozen_costs(r, fc, 5, err) && !r.frozen() && !err.empty(), "v2 apply: S salito oltre la tabella rifiutato");
+        FrozenCosts ff;
+        err.clear();
+        check(!load_frozen_costs_file("/nonexistent/hfc_table.txt", 4, ff, err) && !ff.loaded && !err.empty(),
+              "v2 load: file inesistente rifiutato");
+    }
+    std::printf(g_fail ? "FAIL\n" : "PASS\n");
+    return g_fail ? 1 : 0;
+}
