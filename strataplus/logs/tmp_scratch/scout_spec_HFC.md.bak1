+        if (std::string fe; !load_frozen_costs(policy, o.spec, fe)) { std::fprintf(stderr, "strata generate: %s\n", fe.c_str()); return 1; }
         if (spec_cost && use_mtp)
             mtp.set_chain_rule([&](int idx, float pj) {
```

