+// ---- Strata+ P6 begin: JointHook ----
+// Strata+ P6: JointGate (include/strata/spec/joint_gate.hpp, arm A: tmax=5, skip, no decay) in the engine.
+// SOLO SEQUENZA SINGOLA: the CLI generation loop and the serial GEN loop of --serve.  Never batch_step / BGEN (one MTP
+// draft per slot, no DraftPolicy there) and never the --pipeline-windows path (it keeps DraftPolicy).
+// Exists only with STRATA_SPEC_JOINT=1 (JointGate::enabled_from_env()); without it the loops hold a null pointer and
+// skip every P6 branch, so the default path is the upstream one.
+// Minimal hook: the MTP drafts of a round are made as upstream at the end of the previous round (mtp.draft); the gate
+// decides, at the round start, the source (none / MTP / prompt lookup) and the depth over the drafts already made
+// (start(), keep() up to the drafts available, finish()), then observes the round with full information (both
+// sources scored on the a+1 committed tokens, censored: the counterfactual feedback of P3).  It does not yet skip
+// or stop the MTP draft itself, so the draft time a skip/stop would save is not saved here.
+struct JointHook {
+    using G = strata::spec::JointGate;
+    G gate;
+    G::Choice c;                          // the round in progress
+    G::Lookup lu[G::kSrc];
+    int d_avail = 0, k_lu = 0;
+    float p[G::kD] = {};                  // the MTP drafts' top-1 probs (0 past d_avail)
+    int32_t mtp[G::kD] = {}, lk[G::kD] = {};   // the drafts of both sources, kept for observe()
+
+    static G::Options options(bool use_mtp) {
+        G::Options o;                     // arm A as is
+        o.mtp = use_mtp;
+        return o;
+    }
+    explicit JointHook(bool use_mtp) : gate(options(use_mtp)) {}
+
+    /// Round start (not the first window).  t_plan: the MTP window the engine's own rule allows (its drafts usable
+    /// this round); k / match: the lookup proposal in `sbuf` (k = 0: none); rem: JointGate::remaining(...), bounded by
+    /// max_new and the context.  Returns the window T and sets *from_lookup.
+    int decide(int t_plan, const int32_t* drafts, const float* dprob, int k, int match, const int32_t* sbuf, int rem,
+               bool use_mtp, bool* from_lookup) {
+        d_avail = use_mtp ? std::clamp(t_plan - 1, 0, G::kD) : 0;
+        k_lu = std::clamp(k, 0, G::kD);
+        for (int j = 0; j < G::kD; ++j) {
+            p[j] = j < d_avail ? dprob[j] : 0.0f;
+            mtp[j] = j < d_avail ? drafts[j] : -1;
+            lk[j] = j < k_lu ? sbuf[j] : -1;
+        }
+        lu[0] = G::Lookup{k_lu, k_lu > 0 ? match : 0, k_lu > 0 && d_avail > 0 && lk[0] == mtp[0] ? 1 : 0};
+        lu[1] = G::Lookup{};
+        if (!gate.start(lu, rem, &c)) {   // the MTP's turn: depth by the value test, over the drafts made
+            int d = 0;
+            while (d < d_avail) {
+                ++d;
+                if (!gate.keep(p, nullptr, d)) break;
+            }
+            c = gate.finish(p, d, lu);
+        }
+        *from_lookup = c.src == G::kLookup && c.t > 1;
+        if (c.src == G::kNone) c.t = 1;
+        return std::max(1, c.t);
+    }
+    /// After the commit (a drafts accepted, `ms` the round's measured time): full-information feedback.
+    void observe(int a, double ms, const int32_t* outv) {
+        auto lcp = [&](const int32_t* v, int n) { int i = 0; while (i < n && i <= a && v[i] == outv[i]) ++i; return i; };
+        const int lu_acc[G::kSrc] = {lcp(lk, k_lu), 0};
+        gate.observe(c, a, ms, lcp(mtp, d_avail), p, lu, lu_acc);
+    }
+};
+// STRATA_SPEC_JOINT=1 and nothing in the way: the hook; otherwise null (the caller has checked enabled_from_env())
+std::unique_ptr<JointHook> make_joint_hook(bool use_mtp, const char* blocked_by, const char* who) {
+    if (blocked_by != nullptr) {
+        std::fprintf(stderr, "%s: STRATA_SPEC_JOINT=1 ignored with %s (DraftPolicy as upstream)\n", who, blocked_by);
+        return nullptr;
+    }
+    std::fprintf(stderr, "%s: STRATA_SPEC_JOINT=1: JointGate (arm A, tmax=5) chooses source and depth "
+                         "(solo sequenza singola)\n", who);
+    return std::make_unique<JointHook>(use_mtp);
+}
+// ---- Strata+ P6 end: JointHook ----
