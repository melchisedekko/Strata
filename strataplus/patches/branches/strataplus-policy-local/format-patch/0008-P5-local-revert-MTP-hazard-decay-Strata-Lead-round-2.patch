From: "Bolla (coordinator)" <bolla@users.noreply.github.com>
Date: Sun, 25 Oct 2026 02:07:08 +0100
Subject: [PATCH 08/11] P5 local: revert MTP hazard decay (Strata Lead: round-2
 arm, not a fix); keep (a) bounds, (b) seed_costs, (d) remaining()

---
 src/spec/joint_gate.cpp      |  3 +--
 src/spec/joint_gate_test.cpp | 13 -------------
 2 files changed, 1 insertion(+), 15 deletions(-)

diff --git a/src/spec/joint_gate.cpp b/src/spec/joint_gate.cpp
index 89fae04..c804b9d 100644
--- a/src/spec/joint_gate.cpp
+++ b/src/spec/joint_gate.cpp
@@ -10,7 +10,6 @@ namespace {
 constexpr double kPB[6] = {0.3, 0.6, 0.8, 0.9, 0.95, 0.99};
 constexpr int kMB[4] = {4, 6, 12, 24};
 constexpr int kTRows = 8;          // th_ rows / n_t_ entries: window sizes T = 1..kTRows
-constexpr double kHmDecay = 0.999;  // forgetting of the per-bucket MTP hazards (same as the marginal ones)
 static_assert(strata::spec::JointGate::kD + 1 == kTRows, "window sizes must fit the cost rows");
 int trow(int t) { return std::clamp(t, 1, kTRows) - 1; }   // T > 8 (e.g. an engine chain window) -> last row
 int pbucket(double p) { int b = 0; while (b < 6 && kPB[b] <= p) ++b; return b; }   // searchsorted(side="right")
@@ -213,7 +212,7 @@ void JointGate::observe(const Choice& c, int a, double cost, int mtp_acc, const
         for (int j = 0; j < std::min({obs + (fail ? 1 : 0), c.d, kD}); ++j) {   // c.d > kD: no row
             const int b = pbucket((double) mtp_p[j]);
             const bool ok = j < obs;
-            hm_s_[j][b] = kHmDecay * hm_s_[j][b] + ok; hm_f_[j][b] = kHmDecay * hm_f_[j][b] + !ok;
+            hm_s_[j][b] += ok; hm_f_[j][b] += !ok;
             hmm_s_[j] = 0.999 * hmm_s_[j] + ok; hmm_f_[j] = 0.999 * hmm_f_[j] + !ok;
         }
     }
diff --git a/src/spec/joint_gate_test.cpp b/src/spec/joint_gate_test.cpp
index 0d60bf1..66f9fda 100644
--- a/src/spec/joint_gate_test.cpp
+++ b/src/spec/joint_gate_test.cpp
@@ -112,19 +112,6 @@ int main() {
         check(JointGate::remaining(100, 10, 205, 200) == 4, "rem: context bound (max_context - p - 1)");
         check(JointGate::remaining(100, 10, 0, 200) == 89 && JointGate::remaining(5, 5, 0, 0) == 0, "rem: no bound / >= 0");
     }
-    {   // MTP hazards forget (Scout bug c): after a long reliable phase, a regime change is learned within ~1/(1-0.999)
-        JointGate g;
-        const float hi[7] = {0.999f, 0.999f, 0.999f, 0.999f, 0.999f, 0.999f, 0.999f};
-        const int lu_acc[2] = {0, 0};
-        auto depth = [&]() { JointGate::Choice c; if (g.start(none, 100, &c)) return 0;
-                             int d = 0; while (true) { ++d; if (!g.keep(hi, nullptr, d)) break; } return d; };
-        for (int r = 0; r < 3000; ++r) { JointGate::Choice c; c.src = JointGate::kMtp; c.t = 8; c.d = 7; c.klu = 0;
-                                         g.observe(c, 7, 1.0, 7, hi, none, lu_acc); }
-        const int before = depth();
-        for (int r = 0; r < 3000; ++r) { JointGate::Choice c; c.src = JointGate::kMtp; c.t = 8; c.d = 7; c.klu = 0;
-                                         g.observe(c, 0, 1.0 + 0.05 * 7, 0, hi, none, lu_acc); }
-        check(before >= 5 && depth() <= 2, "decay: confident drafts that stop being accepted are no longer drafted deep");
-    }
     std::printf(g_fail ? "FAIL\n" : "PASS\n");
     return g_fail ? 1 : 0;
 }
