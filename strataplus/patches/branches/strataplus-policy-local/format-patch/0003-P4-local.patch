diff --git a/src/spec/pool_source.cpp b/src/spec/pool_source.cpp
new file mode 100644
index 0000000..57c0313
--- /dev/null
+++ b/src/spec/pool_source.cpp
@@ -0,0 +1,57 @@
+// src/spec/pool_source.cpp - see include/strata/spec/pool_source.hpp (Strata+ P4, local draft).
+#include "strata/spec/pool_source.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <memory>
+
+namespace strata::spec {
+
+// The drafter gets 2x the pool's capacity of room, so it never reaches its own "table full" state before evict().
+PoolSource::PoolSource(size_t capacity, int gate, int max_match)
+    : capacity_(std::max<size_t>(capacity, 1024)), gate_(std::max(gate, 3)), max_match_(std::max(max_match, gate_)),
+      d_(3, max_match_, 2 * capacity_ + 4096) {
+    text_.reserve(capacity_ + 1024);
+}
+
+void PoolSource::append(const int32_t* tokens, size_t n) {
+    if (n == 0) return;
+    if (text_.size() + n > capacity_) evict();
+    text_.insert(text_.end(), tokens, tokens + n);
+    d_.append(tokens, n);
+}
+
+void PoolSource::evict() {
+    const size_t keep = capacity_ / 2;
+    if (text_.size() > keep) text_.erase(text_.begin(), text_.end() - (std::ptrdiff_t) keep);
+    d_.reset();
+    d_.append(text_.data(), text_.size());
+    ++evictions_;
+}
+
+int PoolSource::propose(const int32_t* tail, int n_tail, int n_pending, int max_k, int32_t* out, int* match) {
+    *match = 0;
+    // the pool's own history ends with the current request's committed context (append() saw it), so as for
+    // PromptLookupSource only the pending drafts are passed on
+    n_pending = std::clamp(n_pending, 0, n_tail);
+    const int k = d_.propose_after(tail + (n_tail - n_pending), n_pending, max_k, out);
+    if (k <= 0 || d_.last_match() < gate_) return 0;
+    *match = d_.last_match();
+    return k;
+}
+
+bool register_pool_from_env() {
+    const char* v = std::getenv("STRATA_LOOKUP_POOL");
+    if (v == nullptr || *v == '\0') return false;
+    char* end = nullptr;
+    const unsigned long long cap = std::strtoull(v, &end, 10);
+    int gate = 12;
+    if (end != nullptr && *end == ',') gate = std::atoi(end + 1);
+    if (cap == 0) return false;
+    for (const auto& s : extra_draft_sources())
+        if (s && dynamic_cast<const PoolSource*>(s.get()) != nullptr) return true;   // registered once
+    extra_draft_sources().push_back(std::make_unique<PoolSource>((size_t) cap, gate));
+    return true;
+}
+
+}  // namespace strata::spec
diff --git a/src/spec/pool_source_test.cpp b/src/spec/pool_source_test.cpp
new file mode 100644
index 0000000..6e886f0
--- /dev/null
+++ b/src/spec/pool_source_test.cpp
@@ -0,0 +1,54 @@
+// src/spec/pool_source_test.cpp - Strata+ P4: the persistent pool survives reset(), gates short matches, evicts.
+#include "strata/spec/pool_source.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+bool g_fail = false;
+void check(bool ok, const char* what) {
+    std::printf("  %-64s %s\n", what, ok ? "ok" : "FAIL");
+    g_fail |= !ok;
+}
+}  // namespace
+
+int main() {
+    using strata::spec::PoolSource;
+    std::vector<int32_t> a;
+    for (int i = 0; i < 200; ++i) a.push_back(1000 + i);   // request 1: a distinctive run
+    {
+        PoolSource p(1 << 16, 12);
+        p.append(a.data(), a.size());
+        p.reset();                                          // request 2 starts
+        std::vector<int32_t> r2 = {7, 8, 9};
+        r2.insert(r2.end(), a.begin() + 50, a.begin() + 70);   // repeats 20 tokens of request 1
+        p.append(r2.data(), r2.size());
+        int32_t out[8]; int m = 0;
+        const int k = p.propose(r2.data(), (int) r2.size(), 0, 8, out, &m);
+        check(k > 0 && out[0] == a[70] && m >= 12, "pool: an earlier request's text is proposed after reset()");
+        std::vector<int32_t> r3 = {5, 5, 5};
+        r3.insert(r3.end(), a.begin() + 120, a.begin() + 125);   // only a 5-token repeat
+        p.append(r3.data(), r3.size());
+        const int k3 = p.propose(r3.data(), (int) r3.size(), 0, 8, out, &m);
+        check(k3 == 0 && m == 0, "pool: matches shorter than the gate propose nothing");
+    }
+    {
+        PoolSource p(2048, 12);
+        p.append(a.data(), a.size());
+        std::vector<int32_t> filler;
+        for (int i = 0; i < 3000; ++i) filler.push_back(50000 + (i * 7919) % 40000);
+        for (size_t i = 0; i < filler.size(); i += 100) p.append(filler.data() + i, 100);
+        check(p.evictions() > 0 && p.size() <= 2048, "pool: capacity bounded, oldest text evicted");
+        std::vector<int32_t> q(a.begin() + 50, a.begin() + 70);
+        p.append(q.data(), q.size());
+        int32_t out[8]; int m = 0;
+        check(p.propose(q.data(), (int) q.size(), 0, 8, out, &m) == 0, "pool: evicted text is no longer proposed");
+        std::vector<int32_t> f(filler.end() - 400, filler.end() - 380);
+        p.append(f.data(), f.size());
+        const int k = p.propose(f.data(), (int) f.size(), 0, 8, out, &m);
+        check(k > 0 && out[0] == *(filler.end() - 380), "pool: indexing continues after eviction");
+    }
+    std::printf(g_fail ? "FAIL\n" : "PASS\n");
+    return g_fail ? 1 : 0;
+}
