 // src/spec/joint_gate_test.cpp - Strata+ P5: the joint source+depth gate's basic behaviour.
 #include "strata/spec/joint_gate.hpp"
 
+#include <algorithm>
 #include <cmath>
 #include <cstdio>
 
@@ -65,6 +66,65 @@ int main() {
         if (!g.start(none, 100, &c)) { while (true) { ++d; if (!g.keep(p, ent, d)) break; } }
