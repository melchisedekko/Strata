diff --git a/common/speculative.cpp b/common/speculative.cpp
index 4305ac6..ccf5788 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1857,11 +1857,34 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
                 result.push_back(id);
 
+                if (dp.result_p) { // strata-plus local patch: log the draft's probability (sampler: softmax over top_k=10)
+                    dp.result_p->push_back(cur_p->data[0].p);
+                }
+                if (dp.result_pg || dp.result_ent) { // strata-plus local patch: full-vocab softmax (temp 1) of the MTP logits
+                    // needs the CPU draft sampler (--no-spec-draft-backend-sampling): with backend sampling only the
+                    // top_k=10 logits leave the graph and the full row is not available -> NaN
+                    const int nv = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx_dft)));
+                    const float * lg = llama_get_sampled_logits_ith(ctx_dft, i_last[seq_id]) ? nullptr : llama_get_logits_ith(ctx_dft, i_last[seq_id]);
+                    if (!lg) {
+                        if (dp.result_pg)  dp.result_pg->push_back(NAN);
+                        if (dp.result_ent) dp.result_ent->push_back(NAN);
+                    } else {
+                        float mx = lg[0];
+                        for (int v = 1; v < nv; ++v) mx = std::max(mx, lg[v]);
+                        double z = 0.0, zl = 0.0;
+                        for (int v = 0; v < nv; ++v) { const double e = std::exp((double) lg[v] - mx); z += e; zl += e * ((double) lg[v] - mx); }
+                        if (getenv("SP_DBG")) { int am = 0; for (int v = 1; v < nv; ++v) if (lg[v] > lg[am]) am = v; fprintf(stderr, "SPDBG id=%d am=%d lg_id=%f mx=%f pg=%f psamp=%f\n", id, am, lg[id], mx, std::exp((double) lg[id] - mx) / z, cur_p->data[0].p); }
+                        if (dp.result_pg)  dp.result_pg->push_back((float) (std::exp((double) lg[id] - mx) / z));
+                        if (dp.result_ent) dp.result_ent->push_back((float) (std::log(z) - zl / z));
+                    }
+                }
+
                 if (dp.result_q) {
                     dp.result_q->emplace_back(cur_p->data, cur_p->data + cur_p->size);
                 }
 
-                if (params.n_max <= (int) result.size()) {
+                // strata-plus local patch: also honour the per-call cap dp.n_max (as draft-simple does)
+                if (params.n_max <= (int) result.size() || (dp.n_max > 0 && dp.n_max <= (int) result.size())) {
                     drafting[seq_id] = false;
                     n_drafting--;
                     continue;
