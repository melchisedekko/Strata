+// Strata+ P1: the strataplus.v1 JSONL trace (/workspace/strata-plus/log_format.md), STRATA_PLUS_TRACE=<path>: per request
+// a "request" line, a "round" line per verify window, then a "request_end" line with the committed output (a live
+// engine does not know the output when the request starts: divergence D13 of log_format.md).  Appends; one writer.
+FILE* plus_trace() {
+    static FILE* f = [] { const char* p = std::getenv("STRATA_PLUS_TRACE"); return p != nullptr && *p != '\0' ? std::fopen(p, "a") : nullptr; }();
+    return f;
+}
+void plus_ints(FILE* f, const int32_t* v, int n) {
+    std::fputc('[', f);
+    for (int i = 0; i < n; ++i) std::fprintf(f, i ? ",%d" : "%d", (int) v[i]);
+    std::fputc(']', f);
+}
+void plus_floats(FILE* f, const float* v, int n) {
+    std::fputc('[', f);
+    for (int i = 0; i < n; ++i) std::fprintf(f, i ? ",%.5g" : "%.5g", (double) v[i]);
+    std::fputc(']', f);
+}
+// the drafts of `prop` (k of them) that equal the committed outv[0..a]; *censored when all a+1 known ones matched
+int plus_lcp(const int32_t* prop, int k, const int32_t* outv, int a, bool* censored) {
+    int n = 0;
+    while (n < k && n <= a && prop[n] == outv[n]) ++n;
+    *censored = n == a + 1 && n < k;
+    return n;
+}
