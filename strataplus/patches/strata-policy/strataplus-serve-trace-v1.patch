diff --git a/src/spec/serve_trace.cpp b/src/spec/serve_trace.cpp
new file mode 100644
index 00000000..56755d4c
--- /dev/null
+++ b/src/spec/serve_trace.cpp
@@ -0,0 +1,194 @@
+// src/spec/serve_trace.cpp - Strata+ serve-trace v1 (see include/strata/spec/serve_trace.hpp).
+#include "strata/spec/serve_trace.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <sys/stat.h>
+
+namespace strata::spec::serve_trace {
+namespace {
+std::mutex mu;
+std::FILE* fp = nullptr;
+std::string buf, lang, arb = "off";
+long long req = 0, rounds = 0;
+int frozen = 0;
+bool open_req = false;
+
+void flush_locked() {
+    if (fp == nullptr || buf.empty()) return;
+    std::fwrite(buf.data(), 1, buf.size(), fp);
+    std::fflush(fp);
+    buf.clear();
+}
+
+// SHA-256 (FIPS 180-4), small and dependency-free
+struct Sha {
+    uint32_t h[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+    unsigned char blk[64];
+    size_t n = 0;
+    uint64_t len = 0;
+    static uint32_t r(uint32_t x, int s) { return (x >> s) | (x << (32 - s)); }
+    void compress() {
+        static const uint32_t k[64] = {
+            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
+            0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
+            0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
+            0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+            0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
+            0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
+            0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+            0xc67178f2};
+        uint32_t w[64];
+        for (int i = 0; i < 16; ++i)
+            w[i] = (uint32_t) blk[4 * i] << 24 | (uint32_t) blk[4 * i + 1] << 16 | (uint32_t) blk[4 * i + 2] << 8 | blk[4 * i + 3];
+        for (int i = 16; i < 64; ++i) {
+            const uint32_t s0 = r(w[i - 15], 7) ^ r(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            const uint32_t s1 = r(w[i - 2], 17) ^ r(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+        for (int i = 0; i < 64; ++i) {
+            const uint32_t t1 = hh + (r(e, 6) ^ r(e, 11) ^ r(e, 25)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+            const uint32_t t2 = (r(a, 2) ^ r(a, 13) ^ r(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+        }
+        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+    }
+    void add(const unsigned char* p, size_t m) {
+        for (size_t i = 0; i < m; ++i) { blk[n++] = p[i]; ++len; if (n == 64) { compress(); n = 0; } }
+    }
+    std::string hex() {
+        const uint64_t bits = len * 8;
+        const unsigned char one = 0x80, zero = 0;
+        add(&one, 1);
+        while (n != 56) add(&zero, 1);
+        unsigned char l[8];
+        for (int i = 0; i < 8; ++i) l[i] = (unsigned char) (bits >> (56 - 8 * i));
+        add(l, 8);
+        char out[65];
+        for (int i = 0; i < 8; ++i) std::snprintf(out + 8 * i, 9, "%08x", h[i]);
+        return std::string(out, 64);
+    }
+};
+
+bool valid_lang_char(char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '+' ||
+           c == '#' || c == '.' || c == '-';
+}
+}  // namespace
+
+bool env_set(const char* v) { return v != nullptr && v[0] != '\0' && std::strcmp(v, "0") != 0; }
+
+std::string sha256_hex(const std::string& data) {
+    Sha s;
+    s.add((const unsigned char*) data.data(), data.size());
+    return s.hex();
+}
+
+std::string sha256_file(const char* path) {
+    struct stat st{};
+    if (path == nullptr || ::stat(path, &st) != 0 || !S_ISREG(st.st_mode)) return "";
+    std::FILE* f = std::fopen(path, "rb");
+    if (f == nullptr) return "";
+    Sha s;
+    unsigned char b[65536];
+    size_t m;
+    while ((m = std::fread(b, 1, sizeof b, f)) > 0) s.add(b, m);
+    const bool bad = std::ferror(f) != 0;
+    std::fclose(f);
+    return bad ? "" : s.hex();
+}
+
+std::string lang_of(const char* line) {
+    if (line == nullptr) return "";
+    const char* p = line;
+    while ((p = std::strstr(p, "strata_lang=")) != nullptr) {
+        if (p == line || p[-1] == ' ' || p[-1] == '\t') {
+            const char* v = p + 12;
+            size_t n = 0;
+            while (v[n] != '\0' && v[n] != ' ' && v[n] != '\t' && v[n] != '\n' && v[n] != '\r') ++n;
+            bool ok = n >= 1 && n <= 32;
+            for (size_t i = 0; ok && i < n; ++i) ok = valid_lang_char(v[i]);
+            return ok ? std::string(v, n) : "";
+        }
+        p += 12;
+    }
+    return "";
+}
+
+bool init(const char* path, std::string& err) {
+    std::lock_guard<std::mutex> g(mu);
+    if (fp != nullptr) { std::fclose(fp); fp = nullptr; }
+    buf.clear(); open_req = false; req = 0;
+    if (path == nullptr || path[0] == '\0') return true;
+    fp = std::fopen(path, "a");
+    if (fp == nullptr) {
+        err = std::string("STRATA_SERVE_TRACE: cannot open ") + path + " for writing";
+        return false;
+    }
+    const char* j = std::getenv("STRATA_SPEC_JOINT");
+    const char* d = std::getenv("STRATA_SPEC_JOINT_DET");
+    const char* fz = std::getenv("STRATA_SPEC_COST_FROZEN");
+    arb = env_set(j) ? (env_set(d) ? "det" : "joint") : "off";
+    frozen = env_set(fz) ? 1 : 0;
+    const std::string fsha = frozen ? sha256_file(fz) : "";
+    std::fprintf(fp, "# strata serve trace v1 fields: T a sfx ms p1..p{S-1} path= req= lang= src= arb= frozen= | joint=%s det=%s "
+                     "frozen=%d frozen_value=%s frozen_sha256=%s\n",
+                 j ? j : "-", d ? d : "-", frozen, fz && fz[0] ? fz : "-", fsha.empty() ? "-" : fsha.c_str());
+    std::fflush(fp);
+    return true;
+}
+
+bool init_from_env(std::string& err) { return init(std::getenv("STRATA_SERVE_TRACE"), err); }
+
+bool on() { return fp != nullptr; }
+
+void begin(const char* gen_line) {
+    if (fp == nullptr) return;
+    std::lock_guard<std::mutex> g(mu);
+    if (open_req) flush_locked();
+    ++req; rounds = 0; open_req = true;
+    lang = lang_of(gen_line);
+    char b[96];
+    std::snprintf(b, sizeof b, "# req=%lld begin lang=%s\n", req, lang.empty() ? "-" : lang.c_str());
+    buf += b;
+}
+
+void round(const char* path, int T, int accepted, bool from_lookup, double ms, const float* p, int np) {
+    if (fp == nullptr) return;
+    std::lock_guard<std::mutex> g(mu);
+    char b[160];
+    std::snprintf(b, sizeof b, "%d %d %d %.3f", T, accepted, from_lookup ? 1 : 0, ms);
+    buf += b;
+    for (int i = 0; i < np; ++i) {
+        std::snprintf(b, sizeof b, " %.4f", p ? (double) p[i] : 0.0);
+        buf += b;
+    }
+    std::snprintf(b, sizeof b, " path=%s req=%lld lang=%s src=%s arb=%s frozen=%d\n", path ? path : "-", req,
+                  lang.empty() ? "-" : lang.c_str(), from_lookup ? "lookup" : "mtp", arb.c_str(), frozen);
+    buf += b;
+    ++rounds;
+}
+
+void end(const char* finish, long long produced) {
+    if (fp == nullptr) return;
+    std::lock_guard<std::mutex> g(mu);
+    char b[128];
+    std::snprintf(b, sizeof b, "# req=%lld end finish=%s produced=%lld rounds=%lld\n", req, finish ? finish : "-", produced,
+                  rounds);
+    buf += b;
+    open_req = false;
+    flush_locked();
+}
+
+void close() {
+    std::lock_guard<std::mutex> g(mu);
+    flush_locked();
+    if (fp != nullptr) std::fclose(fp);
+    fp = nullptr;
+}
+
+}  // namespace strata::spec::serve_trace
