+// src/spec/serve_trace_test.cpp - Strata+ serve-trace v1: host test (no model, no GPU).
+#include "strata/spec/serve_trace.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <unistd.h>
+
+namespace st = strata::spec::serve_trace;
+static int fails = 0;
+static void check(bool ok, const char* what) {
+    std::printf("  %-70s %s\n", what, ok ? "ok" : "FAIL");
+    if (!ok) ++fails;
+}
+static std::string slurp(const std::string& p) {
+    std::ifstream f(p);
+    std::stringstream s;
+    s << f.rdbuf();
+    return s.str();
+}
+static bool exists(const std::string& p) { return ::access(p.c_str(), F_OK) == 0; }
+
+int main() {
+    check(st::sha256_hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256(\"\")");
+    check(st::sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256(\"abc\")");
+    check(st::sha256_hex(std::string(1000, 'a')) ==
+              "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3", "sha256(1000 x 'a', multi-block)");
+    check(st::lang_of("GEN 16 temp=0 strata_lang=python 1 2 3") == "python", "lang_of: key present");
+    check(st::lang_of("GEN 16 temp=0 1 2 3").empty(), "lang_of: absent");
+    check(st::lang_of("GEN 16 xstrata_lang=python 1").empty(), "lang_of: not a key boundary");
+    check(st::lang_of("GEN 16 strata_lang=a=b 1").empty() && st::lang_of("GEN 16 strata_lang= 1").empty(),
+          "lang_of: invalid value");
+    check(!st::env_set(nullptr) && !st::env_set("") && !st::env_set("0") && st::env_set("1") && st::env_set("/x"),
+          "env_set");
+
+    char dir[] = "/tmp/serve_trace_testXXXXXX";
+    if (::mkdtemp(dir) == nullptr) { std::printf("mkdtemp failed\n"); return 1; }
+    const std::string path = std::string(dir) + "/trace.txt";
+
+    // knob off: no env -> off, nothing written, no file
+    ::unsetenv("STRATA_SERVE_TRACE");
+    std::string err;
+    check(st::init_from_env(err) && !st::on(), "off: unset env -> ok, off");
+    ::setenv("STRATA_SERVE_TRACE", "", 1);
+    check(st::init_from_env(err) && !st::on(), "off: empty env -> ok, off");
+    st::begin("GEN 4 strata_lang=python 1");
+    st::round("serial", 3, 2, false, 1.5, nullptr, 0);
+    st::end("stop", 3);
+    check(!exists(path), "off: no file is created");
+
+    // unwritable path -> false (the caller exits 1 before the model load)
+    ::setenv("STRATA_SERVE_TRACE", "/nonexistent_dir_strata/trace.txt", 1);
+    err.clear();
+    check(!st::init_from_env(err) && !err.empty() && !st::on(), "unwritable path -> false + message");
+
+    // on
+    ::setenv("STRATA_SERVE_TRACE", path.c_str(), 1);
+    ::setenv("STRATA_SPEC_JOINT", "1", 1);
+    ::setenv("STRATA_SPEC_JOINT_DET", "1", 1);
+    const std::string fz = std::string(dir) + "/frozen.txt";
+    { std::ofstream f(fz); f << "abc"; }
+    ::setenv("STRATA_SPEC_COST_FROZEN", fz.c_str(), 1);
+    err.clear();
+    check(st::init_from_env(err) && st::on(), "on: opens");
+    const float p[3] = {0.9f, 0.5f, 0.25f};
+    st::begin("GEN 8 temp=0 strata_lang=rust 5 6");
+    st::round("serial", 4, 3, false, 2.25, p, 3);
+    check(slurp(path).find("req=1 begin") == std::string::npos, "rounds are buffered until the request ends");
+    st::round("pipeline_t", 2, 1, true, 0.5, p, 3);
+    st::end("length", 8);
+    st::begin("GEN 8 5 6");
+    st::end("stop", 1);
+    st::close();
+    const std::string t = slurp(path);
+    check(t.find("frozen=1 frozen_value=" + fz + " frozen_sha256=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") !=
+              std::string::npos && t.find("joint=1 det=1") != std::string::npos, "header: arbiter + frozen env, file sha256");
+    check(t.find("# req=1 begin lang=rust\n") != std::string::npos, "begin line with strata_lang");
+    check(t.find("4 3 0 2.250 0.9000 0.5000 0.2500 path=serial req=1 lang=rust src=mtp arb=det frozen=1\n") != std::string::npos,
+          "serial round: CLI fields first, then path/req/lang/src/arb/frozen");
+    check(t.find("2 1 1 0.500 0.9000 0.5000 0.2500 path=pipeline_t req=1 lang=rust src=lookup arb=det frozen=1\n") !=
+              std::string::npos, "pipeline round");
+    check(t.find("# req=1 end finish=length produced=8 rounds=2\n") != std::string::npos, "end line");
+    check(t.find("# req=2 begin lang=-\n") != std::string::npos && t.find("# req=2 end finish=stop produced=1 rounds=0\n") !=
+              std::string::npos, "request without strata_lang");
+    ::unsetenv("STRATA_SPEC_COST_FROZEN");
+    ::unsetenv("STRATA_SPEC_JOINT_DET");
+    ::setenv("STRATA_SPEC_COST_FROZEN", "1", 1);   // H1-style "1": frozen=1, no file -> sha "-"
+    check(st::init_from_env(err) && st::on(), "re-open (append)");
+    st::close();
+    const std::string t2 = slurp(path);
+    check(t2.find("joint=1 det=- frozen=1 frozen_value=1 frozen_sha256=-") != std::string::npos, "frozen without a file");
+    std::remove(fz.c_str());
+    std::remove(path.c_str());
+    ::rmdir(dir);
+    std::printf(fails == 0 ? "all ok\n" : "%d FAILED\n", fails);
+    return fails == 0 ? 0 : 1;
+}
