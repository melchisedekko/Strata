+// include/strata/spec/serve_trace.hpp - Strata+ serve-trace v1 (measurement patch, OFF by default).
+//
+// STRATA_SERVE_TRACE=<file>: `strata serve` appends one line per speculative round, the CLI STRATA_SPEC_TRACE fields
+// first and in the same order ("T a sfx ms p1 .. p{S-1}": window rows, drafts accepted, lookup window, round ms, the
+// MTP draft probabilities), then key=value fields:
+//   path=serial|pipeline_t  req=<n>  lang=<strata_lang or ->  src=mtp|lookup  arb=off|joint|det  frozen=0|1
+// One "# req=<n> begin lang=.." line per request, one "# req=<n> end finish=.. produced=.. rounds=.." line, and a
+// "# strata serve trace v1 ..." header with the arbiter / frozen environment (joint=, det=, frozen=, frozen_sha256=).
+// Rounds go to a per-request memory buffer, written and flushed once at the request's end (off the round's path).
+// The arbiter / frozen fields come from the environment only (STRATA_SPEC_JOINT, STRATA_SPEC_JOINT_DET,
+// STRATA_SPEC_COST_FROZEN), so this file needs neither the H1 nor the H-FC code.  It never changes a token or a window.
+#pragma once
+#include <string>
+
+namespace strata::spec::serve_trace {
+
+/// Reads STRATA_SERVE_TRACE: unset/empty -> off, true.  Set -> opens it for appending and writes the header; a path
+/// that cannot be opened -> false with `err` (the caller exits 1, before any model load).
+bool init_from_env(std::string& err);
+bool init(const char* path, std::string& err);   // the same, with an explicit path (tests)
+bool on();
+/// A request starts: its GEN/BGEN line (only its strata_lang=<name> key is read; anything else is ignored).
+void begin(const char* gen_line);
+/// One verified round.  path: "serial" or "pipeline_t".  p: the window's draft probabilities (np of them; p may be null).
+void round(const char* path, int T, int accepted, bool from_lookup, double ms, const float* p, int np);
+/// The request ends: its lines are written and flushed.
+void end(const char* finish, long long produced);
+void close();   // flush and close (tests; the process exit closes it too)
+
+// pure helpers (tests)
+std::string lang_of(const char* gen_line);   // "" when the line has no valid strata_lang=<name>
+std::string sha256_file(const char* path);   // "" when not a readable regular file
+std::string sha256_hex(const std::string& data);
+bool env_set(const char* v);                 // non-null, non-empty, not "0"
+
+}  // namespace strata::spec::serve_trace
