diff --git a/src/spec/lang_knob.cpp b/src/spec/lang_knob.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e0884f5058163fb02dc7675567e184033dc03cf8
--- /dev/null
+++ b/src/spec/lang_knob.cpp
@@ -0,0 +1,289 @@
+// src/spec/lang_knob.cpp - Strata+ H-LANG v1: the per-request language table (lang_knob.hpp).
+// No JSON library in the tree: a small strict parser for the table's subset
+// (objects, strings, numbers, true/false/null; arrays are parsed and rejected where a value is expected).
+#include "strata/spec/lang_knob.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <vector>
+
+namespace strata::spec {
+
+// ---------------------------------------------------------------- minimal JSON
+namespace {
+struct JVal {
+    enum Kind { Null, Bool, Num, Str, Arr, Obj } kind = Null;
+    bool b = false;
+    double num = 0.0;
+    std::string str;
+    std::vector<JVal> arr;
+    std::vector<std::pair<std::string, JVal>> obj;   // in file order (duplicates refused by the parser)
+};
+
+class JParser {
+public:
+    explicit JParser(const std::string& s) : s_(s) {}
+    bool parse(JVal& out, std::string& err) {
+        if (!value(out, 0, err)) return false;
+        ws();
+        if (i_ != s_.size()) { err = at("trailing characters"); return false; }
+        return true;
+    }
+private:
+    const std::string& s_;
+    size_t i_ = 0;
+    std::string at(const std::string& m) const { return m + " at byte " + std::to_string(i_); }
+    void ws() { while (i_ < s_.size() && (s_[i_] == ' ' || s_[i_] == '\t' || s_[i_] == '\n' || s_[i_] == '\r')) ++i_; }
+    bool lit(const char* w) {
+        const size_t n = std::char_traits<char>::length(w);
+        if (s_.compare(i_, n, w) != 0) return false;
+        i_ += n;
+        return true;
+    }
+    bool string(std::string& out, std::string& err) {
+        if (i_ >= s_.size() || s_[i_] != '"') { err = at("expected a string"); return false; }
+        ++i_;
+        out.clear();
+        while (i_ < s_.size()) {
+            const char c = s_[i_++];
+            if (c == '"') return true;
+            if ((unsigned char) c < 0x20) { err = at("control character in a string"); return false; }
+            if (c != '\\') { out += c; continue; }
+            if (i_ >= s_.size()) break;
+            const char e = s_[i_++];
+            switch (e) {
+                case '"': out += '"'; break;
+                case '\\': out += '\\'; break;
+                case '/': out += '/'; break;
+                case 'b': out += '\b'; break;
+                case 'f': out += '\f'; break;
+                case 'n': out += '\n'; break;
+                case 'r': out += '\r'; break;
+                case 't': out += '\t'; break;
+                case 'u': {   // kept only for ASCII (the table's names and rules are ASCII)
+                    if (i_ + 4 > s_.size()) { err = at("short \\u escape"); return false; }
+                    const std::string h = s_.substr(i_, 4);
+                    char* he = nullptr;
+                    const long cp = std::strtol(h.c_str(), &he, 16);
+                    if (he != h.c_str() + 4 || cp <= 0 || cp > 0x7f) { err = at("non-ASCII \\u escape"); return false; }
+                    out += (char) cp;
+                    i_ += 4;
+                    break;
+                }
+                default: err = at("bad escape"); return false;
+            }
+        }
+        err = at("unterminated string");
+        return false;
+    }
+    bool value(JVal& v, int depth, std::string& err) {
+        if (depth > 16) { err = at("nested too deep"); return false; }
+        ws();
+        if (i_ >= s_.size()) { err = at("unexpected end"); return false; }
+        const char c = s_[i_];
+        if (c == '{') {
+            v.kind = JVal::Obj;
+            ++i_;
+            ws();
+            if (i_ < s_.size() && s_[i_] == '}') { ++i_; return true; }
+            for (;;) {
+                ws();
+                std::string k;
+                if (!string(k, err)) return false;
+                for (const auto& kv : v.obj)
+                    if (kv.first == k) { err = at("duplicate key \"" + k + "\""); return false; }
+                ws();
+                if (i_ >= s_.size() || s_[i_] != ':') { err = at("expected ':'"); return false; }
+                ++i_;
+                JVal x;
+                if (!value(x, depth + 1, err)) return false;
+                v.obj.emplace_back(k, std::move(x));
+                ws();
+                if (i_ < s_.size() && s_[i_] == ',') { ++i_; continue; }
+                if (i_ < s_.size() && s_[i_] == '}') { ++i_; return true; }
+                err = at("expected ',' or '}'");
+                return false;
+            }
+        }
+        if (c == '[') {
+            v.kind = JVal::Arr;
+            ++i_;
+            ws();
+            if (i_ < s_.size() && s_[i_] == ']') { ++i_; return true; }
+            for (;;) {
+                JVal x;
+                if (!value(x, depth + 1, err)) return false;
+                v.arr.push_back(std::move(x));
+                ws();
+                if (i_ < s_.size() && s_[i_] == ',') { ++i_; continue; }
+                if (i_ < s_.size() && s_[i_] == ']') { ++i_; return true; }
+                err = at("expected ',' or ']'");
+                return false;
+            }
+        }
+        if (c == '"') { v.kind = JVal::Str; return string(v.str, err); }
+        if (lit("true")) { v.kind = JVal::Bool; v.b = true; return true; }
+        if (lit("false")) { v.kind = JVal::Bool; v.b = false; return true; }
+        if (lit("null")) { v.kind = JVal::Null; return true; }
+        if (c == '-' || (c >= '0' && c <= '9')) {
+            const char* b = s_.c_str() + i_;
+            char* e = nullptr;
+            const double x = std::strtod(b, &e);
+            if (e == b || !std::isfinite(x)) { err = at("bad number"); return false; }
+            i_ += (size_t) (e - b);
+            v.kind = JVal::Num;
+            v.num = x;
+            return true;
+        }
+        err = at("unexpected character");
+        return false;
+    }
+};
+
+const char* rule_name(TRule r) { return r == TRule::Fixed ? "fixed" : r == TRule::MinP ? "min_p" : "default"; }
+}  // namespace
+
+// ---------------------------------------------------------------- language table
+std::string LangTable::lower(const std::string& s) {
+    std::string o(s);
+    for (char& c : o) c = (char) std::tolower((unsigned char) c);
+    return o;
+}
+
+bool LangTable::valid_name(const std::string& lang) {
+    if (lang.empty() || lang.size() > 32) return false;
+    for (const char c : lang)
+        if (!(std::isalnum((unsigned char) c) || c == '_' || c == '+' || c == '#' || c == '.' || c == '-')) return false;
+    return true;
+}
+
+bool LangTable::load_file(const std::string& path, std::string& err) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f) { err = "cannot open " + path; return false; }
+    std::ostringstream ss;
+    ss << f.rdbuf();
+    if (!load_text(ss.str(), err)) { err = path + ": " + err; return false; }
+    return true;
+}
+
+bool LangTable::load_text(const std::string& json, std::string& err) {
+    JVal root;
+    if (!JParser(json).parse(root, err)) return false;
+    if (root.kind != JVal::Obj) { err = "the top level must be an object"; return false; }
+    std::map<std::string, LangRule> rules;
+    bool have_schema = false, have_langs = false;
+    for (const auto& [k, v] : root.obj) {
+        if (k == "schema") {
+            if (v.kind != JVal::Str || v.str != "strataplus.lang_knob.v1") {
+                err = "schema must be \"strataplus.lang_knob.v1\"";
+                return false;
+            }
+            have_schema = true;
+        } else if (k == "comment" || k == "_comment" || k == "source") {
+            if (v.kind != JVal::Str) { err = "\"" + k + "\" must be a string"; return false; }
+        } else if (k == "languages") {
+            if (v.kind != JVal::Obj) { err = "\"languages\" must be an object"; return false; }
+            have_langs = true;
+            for (const auto& [name, e] : v.obj) {
+                if (!valid_name(name)) { err = "language \"" + name + "\": name must match [A-Za-z0-9_+#.-]{1,32}"; return false; }
+                const std::string key = lower(name);
+                if (rules.count(key) != 0) { err = "language \"" + name + "\" listed twice (names are case-insensitive)"; return false; }
+                if (e.kind != JVal::Obj) { err = "language \"" + name + "\" must be an object"; return false; }
+                LangRule r;
+                bool has_t = false, has_tmax = false;
+                for (const auto& [f, x] : e.obj) {
+                    const std::string where = "language \"" + name + "\": ";
+                    if (f == "spec_min_p") {
+                        if (x.kind != JVal::Num || x.num < 0.0 || x.num > 1.0) { err = where + "spec_min_p must be a number in [0, 1]"; return false; }
+                        r.has_min_p = true;
+                        r.spec_min_p = x.num;
+                    } else if (f == "t_rule") {
+                        if (x.kind != JVal::Str) { err = where + "t_rule must be a string"; return false; }
+                        if (x.str == "default") r.rule = TRule::Default;
+                        else if (x.str == "min_p") r.rule = TRule::MinP;
+                        else if (x.str == "fixed") r.rule = TRule::Fixed;
+                        else { err = where + "t_rule must be \"default\", \"min_p\" or \"fixed\""; return false; }
+                    } else if (f == "t" || f == "t_max") {
+                        if (x.kind != JVal::Num || x.num != std::floor(x.num) || x.num < 1 || x.num > kMaxT) {
+                            err = where + f + " must be an integer in [1, " + std::to_string(kMaxT) + "]";
+                            return false;
+                        }
+                        if (f == "t") { r.t = (int) x.num; has_t = true; }
+                        else { r.t_max = (int) x.num; has_tmax = true; }
+                    } else if (f == "comment" || f == "_comment") {
+                        if (x.kind != JVal::Str) { err = where + "comment must be a string"; return false; }
+                    } else {
+                        err = where + "unknown field \"" + f + "\"";
+                        return false;
+                    }
+                }
+                const std::string where = "language \"" + name + "\": ";
+                if (r.rule == TRule::Fixed && !has_t) { err = where + "t_rule \"fixed\" needs \"t\""; return false; }
+                if (r.rule != TRule::Fixed && has_t) { err = where + "\"t\" is only for t_rule \"fixed\""; return false; }
+                if (r.rule != TRule::MinP && has_tmax) { err = where + "\"t_max\" is only for t_rule \"min_p\""; return false; }
+                rules.emplace(key, r);
+            }
+        } else {
+            err = "unknown top-level field \"" + k + "\"";
+            return false;
+        }
+    }
+    if (!have_schema) { err = "missing \"schema\": \"strataplus.lang_knob.v1\""; return false; }
+    if (!have_langs) { err = "missing \"languages\""; return false; }
+    rules_ = std::move(rules);
+    return true;
+}
+
+const LangRule* LangTable::find(const std::string& lang) const {
+    if (lang.empty()) return nullptr;
+    const auto it = rules_.find(lower(lang));
+    return it == rules_.end() ? nullptr : &it->second;
+}
+
+std::string LangTable::describe() const {
+    std::string o = std::to_string(rules_.size()) + " languages:";
+    char b[96];
+    for (const auto& [k, r] : rules_) {
+        if (r.rule == TRule::Fixed) std::snprintf(b, sizeof b, " %s(T=%d)", k.c_str(), r.t);
+        else if (r.rule == TRule::MinP) std::snprintf(b, sizeof b, " %s(min_p%s%.3g,t_max=%d)", k.c_str(),
+                                                      r.has_min_p ? "=" : "", r.has_min_p ? r.spec_min_p : 0.0, r.t_max);
+        else if (r.has_min_p) std::snprintf(b, sizeof b, " %s(spec_min_p=%.3g)", k.c_str(), r.spec_min_p);
+        else std::snprintf(b, sizeof b, " %s(%s)", k.c_str(), rule_name(r.rule));
+        o += b;
+    }
+    return o;
+}
+
+LangChoice resolve_lang(const LangTable* tab, const std::string& lang, double global_min_p, bool req_set,
+                        double req_min_p) {
+    LangChoice c;
+    c.spec_min_p = req_set ? req_min_p : global_min_p;
+    c.draft_min_p = c.spec_min_p;
+    const LangRule* r = tab != nullptr ? tab->find(lang) : nullptr;
+    if (r == nullptr) return c;   // knob off / missing / unknown: exactly upstream
+    c.matched = true;
+    if (!req_set && r->has_min_p) c.spec_min_p = r->spec_min_p;
+    c.rule = r->rule;
+    c.t = r->t;
+    c.t_max = r->t_max;
+    c.draft_min_p = c.rule == TRule::Fixed ? 0.0 : c.spec_min_p;
+    return c;
+}
+
+int lang_window(const LangChoice& c, int t_upstream, int S_mtp, const float* dprob, int n_prob) {
+    if (!c.matched || c.rule == TRule::Default) return t_upstream;
+    const int cap = std::max(1, std::min(S_mtp, LangTable::kMaxT));
+    if (c.rule == TRule::Fixed) return std::clamp(c.t, 1, cap);
+    const int cap2 = std::max(1, std::min(cap, c.t_max));   // MinP
+    int T = 1;
+    while (T < cap2 && T - 1 < n_prob && dprob != nullptr && dprob[T - 1] >= (float) c.spec_min_p) ++T;
+    return T;
+}
+
+}  // namespace strata::spec
diff --git a/src/spec/lang_knob_test.cpp b/src/spec/lang_knob_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1db95f777901642fae38955e15c5277c5e2704a9
--- /dev/null
+++ b/src/spec/lang_knob_test.cpp
@@ -0,0 +1,102 @@
+// src/spec/lang_knob_test.cpp - Strata+ H-LANG v1: the per-request language table (lang_knob.hpp).
+#include "strata/spec/lang_knob.hpp"
+
+#include <cstdio>
+#include <string>
+
+namespace {
+bool g_fail = false;
+void check(bool ok, const char* what) {
+    std::printf("  %-72s %s\n", what, ok ? "ok" : "FAIL");
+    g_fail |= !ok;
+}
+}  // namespace
+
+int main() {
+    std::printf("lang_knob_test\n");
+    using strata::spec::LangTable;
+    using strata::spec::TRule;
+    {
+        LangTable t;
+        std::string err;
+        const bool ok = t.load_text(R"({"schema":"strataplus.lang_knob.v1","comment":"x",
+            "languages":{"Python":{"spec_min_p":0.3,"t_rule":"min_p","t_max":6},
+                         "rust":{"t_rule":"fixed","t":4},
+                         "go":{"spec_min_p":0.5}}})", err);
+        check(ok && t.size() == 3, "load_text: valid table");
+        if (!ok) std::printf("    err: %s\n", err.c_str());
+        check(t.find("python") != nullptr && t.find("PYTHON") != nullptr, "names are case-insensitive");
+        check(t.find("cobol") == nullptr && t.find("") == nullptr, "unknown / empty language: no rule");
+        // resolve: knob off, unknown, request override, fixed
+        auto c0 = strata::spec::resolve_lang(nullptr, "python", 0.2, false, 0.0);
+        check(!c0.matched && c0.spec_min_p == 0.2 && c0.rule == TRule::Default, "knob off: global spec_min_p, upstream rule");
+        auto c1 = strata::spec::resolve_lang(&t, "cobol", 0.2, false, 0.0);
+        check(!c1.matched && c1.spec_min_p == 0.2, "unknown language: global default");
+        auto c2 = strata::spec::resolve_lang(&t, "python", 0.2, false, 0.0);
+        check(c2.matched && c2.spec_min_p == 0.3 && c2.draft_min_p == 0.3 && c2.rule == TRule::MinP, "table spec_min_p");
+        auto c3 = strata::spec::resolve_lang(&t, "python", 0.2, true, 0.7);
+        check(c3.spec_min_p == 0.7, "request spec_min_p wins over the table");
+        auto c4 = strata::spec::resolve_lang(&t, "rust", 0.2, false, 0.0);
+        check(c4.rule == TRule::Fixed && c4.t == 4 && c4.draft_min_p == 0.0, "fixed: drafter min_p 0");
+        const float pr[7] = {0.9f, 0.8f, 0.7f, 0.2f, 0.9f, 0.9f, 0.9f};
+        check(strata::spec::lang_window(c4, 6, 6, pr, 7) == 4, "fixed T=4 with S_mtp=6");
+        check(strata::spec::lang_window(c4, 6, 3, pr, 7) == 3, "fixed T capped at S_mtp");
+        check(strata::spec::lang_window(c2, 6, 8, pr, 7) == 4, "min_p 0.3: T = 1 + 3 drafts");
+        auto c5 = c2; c5.spec_min_p = 0.0;
+        check(strata::spec::lang_window(c5, 8, 12, pr, 7) == 6, "min_p: capped at t_max=6 (S_mtp 12, kMaxT 8)");
+        check(strata::spec::lang_window(c1, 5, 8, pr, 7) == 5, "unmatched: upstream T unchanged");
+        auto c6 = strata::spec::resolve_lang(&t, "go", 0.2, false, 0.0);
+        check(c6.rule == TRule::Default && c6.spec_min_p == 0.5 && strata::spec::lang_window(c6, 7, 8, pr, 7) == 7,
+              "default rule: only spec_min_p changes, T from the upstream rule");
+    }
+    {   // refused tables
+        const char* bad[] = {
+            R"({"languages":{}})",
+            R"({"schema":"strataplus.lang_knob.v2","languages":{}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{"t_rule":"fixed"}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{"t_rule":"fixed","t":9}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{"spec_min_p":1.5}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{"S":4}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{},"PY":{}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"p y":{}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{"py":{"t":3}}})",
+            R"({"schema":"strataplus.lang_knob.v1","languages":{}} x)",
+        };
+        bool all = true;
+        for (const char* b : bad) {
+            LangTable t;
+            std::string err;
+            if (t.load_text(b, err)) { all = false; std::printf("    accepted: %s\n", b); }
+        }
+        check(all, "malformed tables refused");
+    }
+    {   // H-LANG flag-off identity, exhaustive over a grid: with no table (knob off) - or a table and a request without /
+        // with an unknown strata_lang - the effective parameters are exactly the upstream ones: spec_min_p = the request's
+        // value when it set one, else --spec-min-p; the drafter's floor the same; the T of the upstream rule untouched.
+        LangTable t;
+        std::string err;
+        t.load_text(R"({"schema":"strataplus.lang_knob.v1","languages":{"python":{"spec_min_p":0.3,"t_rule":"fixed","t":2}}})", err);
+        const float pr[8] = {0.95f, 0.5f, 0.05f, 0.7f, 0.3f, 0.99f, 0.01f, 0.6f};
+        long n = 0, bad = 0;
+        for (const LangTable* tab : {(const LangTable*) nullptr, (const LangTable*) &t})
+            for (const char* lang : {"", "cobol", "python"})
+                for (double g : {0.0, 0.1, 0.25, 0.5, 1.0})
+                    for (int rs = 0; rs < 2; ++rs)
+                        for (double rq : {0.0, 0.05, 0.3, 0.9}) {
+                            if (tab != nullptr && std::string(lang) == "python") continue;   // the one matching case
+                            const auto c = strata::spec::resolve_lang(tab, lang, g, rs != 0, rq);
+                            const double up = rs ? rq : g;
+                            bool ok = !c.matched && c.spec_min_p == up && c.draft_min_p == up;
+                            for (int tu = 1; tu <= 12; ++tu)
+                                for (int S = 1; S <= 12; ++S) ok &= strata::spec::lang_window(c, tu, S, pr, 8) == tu;
+                            ++n;
+                            bad += !ok;
+                        }
+        std::printf("    flag-off grid: %ld cases, %ld differ\n", n, bad);
+        check(bad == 0 && n > 0, "knob off / unknown / missing strata_lang: effective params == upstream (grid)");
+        LangTable f;
+        check(!f.load_file("/nonexistent/strataplus_lang.json", err), "load_file: missing file refused");
+    }
+    std::printf(g_fail ? "FAILED\n" : "all ok\n");
+    return g_fail ? 1 : 0;
+}
