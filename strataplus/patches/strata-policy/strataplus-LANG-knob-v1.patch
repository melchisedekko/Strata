new file mode 100644
index 0000000000000000000000000000000000000000..a9fabbf260b9710274f3ca88b55350c93104802b
--- /dev/null
+++ b/docs/strataplus_lang_knob.md
@@ -0,0 +1,22 @@
+# Strata+ H-LANG v1 - per-request language knob (serve, local, opt-in)
+
+Applies on top of P-H1 (`strataplus-H1-arbiter-v1.patch`). Default: OFF; without the table the engine is upstream:
+the request key `strata_lang=` is skipped like any unknown GEN key and the effective parameters are unchanged.
+
+* Startup: `--spec-lang-table FILE` or `STRATA_SPEC_LANG_TABLE=FILE` (the flag wins). The file is loaded and
+  validated right after argument parsing, before any model load; missing file, malformed JSON, unknown field or out-of-
+  range value -> message on stderr, exit code 1. Never half-applied.
+* Request (serve GEN line): `strata_lang=<name>` (case-insensitive, `[A-Za-z0-9_+#.-]{1,32}`). Missing or unknown
+  language -> global default (`--spec-min-p`, upstream T rule). No language detection.
+* Table (`strataplus.lang_knob.v1`): per language an optional `spec_min_p` in [0,1] and a T rule:
+  `default` (upstream rule with the effective spec_min_p), `min_p` (T = 1 + drafts with prob >= spec_min_p, capped at
+  min(S_mtp, `t_max`, 8)), `fixed` (T = min(`t`, S_mtp, 8); the drafter's min_p is 0 so all T-1 drafts exist).
+  Always T <= S_mtp, kMaxT = 8. S, S_mtp and the lookup cap are never changed per request.
+* spec_min_p precedence: the request's own `spec_min_p=` > the table > `--spec-min-p`.
+* Scope: serial serve GEN loop only. Not applied to BGEN (batched), to the pipeline-windows T, nor to non-first windows
+  when `STRATA_SPEC_COST=1` drives T (the DraftPolicy keeps its own rule there). The SYCL engine accepts the flag/env
+  and prints "ignorata su SYCL"; the qwen35moe path prints a warning. `serve/server.py` does not forward
+  `strata_lang` yet (the GEN key works when the engine is driven directly).
+* Example file (format only, placeholder numbers): `strataplus/tests/lang_table_example.json`.
+* Tests: ctest `lang_knob_test` (parser, resolution, windows, 200-case flag-off grid = upstream parameters, missing
+  file); `strataplus/tests/greedy_identity.py --lang-table FILE` (prepared, not run: loads a model).
diff --git a/include/strata/spec/lang_knob.hpp b/include/strata/spec/lang_knob.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..b00ff8dd4da41a99e974cef25c56bfdb81a3a700
--- /dev/null
+++ b/include/strata/spec/lang_knob.hpp
@@ -0,0 +1,68 @@
+// include/strata/spec/lang_knob.hpp - Strata+ H-LANG v1: per-request language knob (serve), OFF by default.
+//
+// Per-request language knob (serve only, serial GEN loop):
+//      --spec-lang-table FILE  or  STRATA_SPEC_LANG_TABLE=FILE   (startup; the flag wins over the env)
+//    Without it the knob is OFF: the request key strata_lang= is skipped like any unknown key.  With it, a GEN line may
+//    carry strata_lang=<name>; the table maps <name> (lowercase, [a-z0-9_+#.-], <= 32 chars) to an optional
+//    spec_min_p and a T rule.  Missing or unknown language -> the global default (--spec-min-p, upstream T rule).
+//    No language detection.  S, S_mtp and the lookup cap are never changed per request.
+//    JSON (schema "strataplus.lang_knob.v1"):
+//      {"schema": "strataplus.lang_knob.v1",
+//       "languages": {"python": {"spec_min_p": 0.3, "t_rule": "min_p", "t_max": 6},
+//                     "rust":   {"t_rule": "fixed", "t": 4},
+//                     "go":     {"spec_min_p": 0.5}}}
+//    t_rule: "default" (upstream rule with the effective spec_min_p; the default when absent),
+//            "min_p"   (T = 1 + the drafts whose prob >= spec_min_p, capped at min(S_mtp, t_max, kMaxT)),
+//            "fixed"   (T = min(t, S_mtp, kMaxT); the drafter's min_p is 0 for that request so all T-1 drafts exist).
+//    Precedence of spec_min_p: the request's own spec_min_p= key > the table's > --spec-min-p.
+//    Unknown fields / bad values: the table is refused at startup (the engine exits), never half-applied.
+#pragma once
+#include <map>
+#include <string>
+
+namespace strata::spec {
+
+enum class TRule { Default = 0, MinP = 1, Fixed = 2 };
+
+struct LangRule {
+    bool has_min_p = false;
+    double spec_min_p = 0.0;
+    TRule rule = TRule::Default;
+    int t = 0;        // fixed: the window (1..kMaxT)
+    int t_max = 8;    // min_p: cap (1..kMaxT)
+};
+
+class LangTable {
+public:
+    static constexpr int kMaxT = 8;
+    bool load_file(const std::string& path, std::string& err);
+    bool load_text(const std::string& json, std::string& err);
+    /// The rule for `lang` (case-insensitive); nullptr when unknown or empty (-> global default).
+    const LangRule* find(const std::string& lang) const;
+    size_t size() const { return rules_.size(); }
+    std::string describe() const;   // one line for the startup log
+    static bool valid_name(const std::string& lang);   // [A-Za-z0-9_+#.-]{1,32}
+    static std::string lower(const std::string& s);
+private:
+    std::map<std::string, LangRule> rules_;
+};
+
+/// What one request runs with (resolve_lang()).
+struct LangChoice {
+    bool matched = false;      // the language was found in the table
+    double spec_min_p = 0.0;   // the floor for the T rule (and the drafter, unless fixed)
+    double draft_min_p = 0.0;  // the drafter's min_p (0 for "fixed")
+    TRule rule = TRule::Default;
+    int t = 0, t_max = LangTable::kMaxT;
+};
+
+/// tab == nullptr (knob off), empty/unknown lang: matched=false, spec_min_p = the request's (req_set) or the global
+/// value, rule Default: exactly upstream.
+LangChoice resolve_lang(const LangTable* tab, const std::string& lang, double global_min_p, bool req_set,
+                        double req_min_p);
+/// The window for a matched MinP / Fixed choice.  dprob: the drafter's top-1 probs (dprob[j] for draft j), n_prob of
+/// them readable.  Default (or !matched): returns t_upstream unchanged.  Never above min(S_mtp, kMaxT) for MinP/Fixed,
+/// never below 1.
+int lang_window(const LangChoice& c, int t_upstream, int S_mtp, const float* dprob, int n_prob);
+
+}  // namespace strata::spec
