index 0000000..3cf116c
--- /dev/null
+++ b/include/strata/spec/joint_gate.hpp
@@ -0,0 +1,102 @@
+// include/strata/spec/joint_gate.hpp - Strata+ P5 (local draft, H1+H4): one gate that chooses the draft SOURCE
+// (none / MTP / prompt lookup / pool) and the MTP DEPTH together.  C++ port of the replay's GateV2
+// (/workspace/strata-policy/replay/strata_sim/sim2.py), kept decision-for-decision identical so the offline replay
+// can link it (parity test: replay/tests/test_joint_gate_parity.py).
+//
+// Per round:
+//   start()      - before any MTP draft: if a lookup proposal already beats the best value the MTP could reach
+//                  (marginal hazards), take it and skip the MTP draft (lookup-first);
+//   keep()       - after each MTP draft j (its top-1 prob, optionally its entropy): draft another one?  The value
+//                  test compares the best window available now with the best reachable deeper (inherit-last-bucket
+//                  hazards); conf_stop replaces it by the AdaEDL-style stop 1 - sqrt(gamma*H_j) < eta (H4 variant);
+//   finish()     - with the drafts known: best of MTP windows 1..d, none, lookup windows (agreement now known);
+//   observe()    - full-information, censored feedback: the played round's cost, both sources' drafts scored on
+//                  the a+1 committed tokens.
+// Objective: Dinkelbach E[a+1] - lambda*C, lambda = decayed tokens/cost of the rounds played.  Cost model: online
+// RLS on one-hot(T) + rho_mtp*d + rho_lu*k (optimistic prior, monotone in T); frozen() keeps the seeded table.
+// SCOPE: single sequence only (CLI and the --serve GEN loop, where DraftPolicy runs).  The batch path (batch_step /
+// BGEN) uses one MTP draft per slot and never calls DraftPolicy or this gate: no effect on parallel > 1 serving.
+// LIMITS (Strata+ H1, Strata Lead decision 25/10/2026: arm A = gate_v2 tmax=5, frozen_params_v3.json sha256 37bf1996...):
+//   - Valid ONLY for a single sequence: the CLI and the GEN loop of --serve.  batch_step / BGEN does NOT use DraftPolicy
+//     (one MTP draft per slot): no effect, and no claim, for parallel > 1 serving.
+//   - Every tok/s figure behind this choice is ESTIMATED by the offline replay on a CPU proxy (Qwen3.5-2B Q4_K_M,
+//     llama.cpp); none is an AMD measurement.
+//   - Holdout v1.1 (replay): vs the default policy, a gain in all three domains (code, chat, edit) in the rho band
+//     0.06-0.15; vs k=3, no cell clearly worse.
+//   - Vs STRATA_SPEC_COST=1, chat: NO gain, and one cell clearly worse (chat, profile P1, rho 0.0791: -1.4% [-2.8; -0.2]
+//     IC95).  This agrees with the H4(a) NO-GO; P1 is a cost profile estimated from the code, not measured.
+//   - Holdout v1.1 is now USED: any future comparison needs a NEW holdout.
+// DEFAULTS = arm A: tmax=5 (windows T<=5, d<=4), skip=true (lookup-first), prompt lookup only, no conf_stop, no hazard
+// decay.  STRATA_SPEC_JOINT=1 (enabled_from_env()) selects this gate with Options() as is; without the variable nothing
+// changes (DraftPolicy, upstream 7dd5cf18 behaviour).  Engine wiring in generate.cpp: see docs/strataplus_joint_gate.md.
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace strata::spec {
+
+class JointGate {
+public:
+    static constexpr int kD = 7;             // MTP drafts considered (Dmax)
+    static constexpr int kSrc = 2;           // 0 = prompt lookup (the request's text), 1 = pool
+    struct Options {
+        bool use_src[kSrc] = {true, false};
+        bool mtp = true, skip = true, conf_stop = false;
+        double gamma = 0.5, eta = 0.35;
+        int tmax = 5;   // arm A (Strata Lead decision); arm B (tmax=8) is round 2, needs a new holdout then AMD
+    };
+    struct Lookup { int k = 0, match = 0, agree = -1; };   // agree: first lookup draft == first MTP draft (-1 unknown)
+    enum Src { kNone = 0, kMtp = 1, kLookup = 2, kPool = 3 };
+    struct Choice { int src = kNone, t = 1, d = 0, klu = 0; };
+
+    JointGate();
+    explicit JointGate(const Options& o);
+
+    /// Round start.  `rem` = tokens still to generate after the next one.  Returns true when a lookup window is taken
+    /// without drafting the MTP (`*out` filled), false when the MTP should draft (then keep()/finish()).
+    bool start(const Lookup lu[kSrc], int rem, Choice* out);
+    /// After the MTP drafted `d` tokens with top-1 probs `p[0..d)` (entropies `ent`, may be null): draft another?
+    bool keep(const float* p, const float* ent, int d);
+    Choice finish(const float* p, int d, const Lookup lu[kSrc]);
+    /// After the round: the window played, its committed tokens (accepted a), its cost, and how many drafts of each
+    /// candidate equal the committed tokens (acc_true: the replay knows them; the engine passes the a+1-censored LCP,
+    /// which censored() treats identically).
+    void observe(const Choice& c, int accepted, double cost, int mtp_acc, const float* mtp_p, const Lookup lu[kSrc],
+                 const int lu_acc[kSrc]);
+    double lambda() const { return lam_n_ / lam_c_; }
+    void set_frozen(bool on) { frozen_ = on; }
+    /// Seed the cost model with a measured table (STRATA_SPEC_COST_TABLE): s(T) for T = 1..8 in units of one plain
+    /// step, the per-draft MTP cost and the per-token lookup cost in the same units, and the step cost `unit` (e.g. ms)
+    /// that converts them to observed costs.  With set_frozen(true) the gate then plans on exactly this table (before,
+    /// frozen kept the 1+0.15(T-1) prior scaled by the first sample).  Without frozen the RLS starts from it.
+    void seed_costs(const double s_by_t[8], double rho_mtp, double rho_lu, double unit);
+    /// `rem` for start(): tokens still allowed after the next one, bounded by max_new AND by the context window (the
+    /// engine stops when p + T > max_context; max_context <= 0 = no context bound).  Never negative.
+    static int remaining(int max_new, int produced, int max_context, int pos);
+    /// STRATA_SPEC_JOINT=1: use this gate (with the arm-A defaults of Options()) instead of DraftPolicy.  Unset or any
+    /// other value: false, DraftPolicy as upstream.
+    static bool enabled_from_env();
+    double cost_pred(int t, int d, int k) const;   // t clamped to 1..8
+    int tmax() const { return o_.tmax; }
+
+private:
+    void lu_haz(int s, int match, int ag, double h[kD]) const;
+    void mtp_haz(const float* p, int n, double h[kD]) const;
+    static int expect(const double h[kD], int kmax, double e[kD + 1]);
+    bool best_lookup(const Lookup lu[kSrc], int d, bool ag_known, double lam, int rem, double* v, int* s, int* t) const;
+    void cost_update(int t, int d, int k, double c);
+
+    Options o_;
+    double hm_s_[kD][7], hm_f_[kD][7], hmm_s_[kD], hmm_f_[kD];
+    double hl_s_[kSrc][5][3][3], hl_f_[kSrc][5][3][3];
+    std::array<double, 10> th_{};
+    double P_[10][10] = {};
+    double scale_ = 0.0;   // 0: not set yet
+    std::array<double, 8> n_t_{};   // samples per window size
+    bool frozen_ = false;
+    double lam_n_ = 1.0, lam_c_ = 1.0;
+    // the round in progress
+    int rem_ = 0, klu_ = 0, kmax_ = 0;
+};
+
+}  // namespace strata::spec
diff --git a/src/spec/joint_gate.cpp b/src/spec/joint_gate.cpp
new file mode 100644
index 0000000..a0bdf8e
--- /dev/null
+++ b/src/spec/joint_gate.cpp
@@ -0,0 +1,242 @@
+// src/spec/joint_gate.cpp - see include/strata/spec/joint_gate.hpp (Strata+ P5, local draft).
+#include "strata/spec/joint_gate.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+
+namespace strata::spec {
+
+namespace {
+constexpr double kPB[6] = {0.3, 0.6, 0.8, 0.9, 0.95, 0.99};
+constexpr int kMB[4] = {4, 6, 12, 24};
+constexpr int kTRows = 8;          // th_ rows / n_t_ entries: window sizes T = 1..kTRows
+static_assert(strata::spec::JointGate::kD + 1 == kTRows, "window sizes must fit the cost rows");
+int trow(int t) { return std::clamp(t, 1, kTRows) - 1; }   // T > 8 (e.g. an engine chain window) -> last row
+int pbucket(double p) { int b = 0; while (b < 6 && kPB[b] <= p) ++b; return b; }   // searchsorted(side="right")
+int mbucket(int m) { int b = 0; while (b < 4 && kMB[b] <= m) ++b; return b; }
+void censored(int acc_true, int k_alt, int a, int* obs, bool* fail) {
+    const int known = a + 1;
+    if (acc_true < std::min(k_alt, known)) { *obs = acc_true; *fail = true; return; }
+    *obs = std::min({acc_true, k_alt, known});
+    *fail = false;
+}
+}  // namespace
+
+JointGate::JointGate() : JointGate(Options()) {}
+
+bool JointGate::enabled_from_env() {
+    const char* v = std::getenv("STRATA_SPEC_JOINT");
+    return v != nullptr && v[0] == '1';
+}
+
+JointGate::JointGate(const Options& o) : o_(o) {
+    o_.tmax = std::clamp(o_.tmax, 1, kD + 1);   // expect()/th_ have room for T <= kD + 1 = 8 only
+    const double pri[7] = {0.15, 0.45, 0.7, 0.85, 0.92, 0.97, 0.99};
+    for (int j = 0; j < kD; ++j) {
+        for (int b = 0; b < 7; ++b) { hm_s_[j][b] = pri[b] * 2; hm_f_[j][b] = (1 - pri[b]) * 2; }
+        hmm_s_[j] = 1.2; hmm_f_[j] = 0.8;
+    }
+    for (auto& a : hl_s_) for (auto& b : a) for (auto& c : b) for (double& x : c) x = 1.2;
+    for (auto& a : hl_f_) for (auto& b : a) for (auto& c : b) for (double& x : c) x = 0.8;
+    for (int t = 0; t < 8; ++t) th_[(size_t) t] = 1.0 + 0.15 * t;
+    th_[8] = 0.05; th_[9] = 0.001;
+    for (int i = 0; i < 10; ++i) P_[i][i] = 1.0;
+    P_[8][8] = 0.01; P_[9][9] = 1e-4;
+}
+
+double JointGate::cost_pred(int t, int d, int k) const {
+    const double v = th_[(size_t) trow(t)] + th_[8] * d + th_[9] * k;
+    return std::max(1e-3, v) * (scale_ > 0 ? scale_ : 1.0);
+}
+
+void JointGate::cost_update(int t, int d, int k, double c) {
+    const int r = trow(t);
+    double x[10] = {};
+    x[r] = 1; x[8] = d; x[9] = k;
+    double xt = 0; for (int i = 0; i < 10; ++i) xt += th_[(size_t) i] * x[i];
+    if (!(scale_ > 0)) scale_ = c / std::max(1e-3, xt);
+    if (frozen_) return;
+    const double y = c / scale_, lam = 0.999;
+    double Px[10] = {}, den = lam;
+    for (int i = 0; i < 10; ++i) { for (int j = 0; j < 10; ++j) Px[i] += P_[i][j] * x[j]; }
+    for (int i = 0; i < 10; ++i) den += x[i] * Px[i];
+    double g[10];
+    for (int i = 0; i < 10; ++i) g[i] = Px[i] / den;
+    for (int i = 0; i < 10; ++i) th_[(size_t) i] += g[i] * (y - xt);
+    for (int i = 0; i < 10; ++i)
+        for (int j = 0; j < 10; ++j) P_[i][j] = (P_[i][j] - g[i] * Px[j]) / lam;
+    n_t_[(size_t) r] += 1;
+    // per-token draft/lookup costs are >= 0: lookup rows (d=0, k>0) otherwise let r_lu absorb a T-row error
+    th_[8] = std::max(th_[8], 0.0); th_[9] = std::max(th_[9], 0.0);
+    // monotone in T only for rows with < 3 samples: clamping a measured row to a still-unlearned neighbour froze it
+    for (int t2 = 1; t2 < 8; ++t2)
+        if (n_t_[t2] < 3) th_[(size_t) t2] = std::max(th_[(size_t) t2], th_[(size_t) t2 - 1]);
+    // a window size tried < 3 times costs at most the line through its tried neighbours (extended past the widest
+    // tried size): a prior scaled by the first sample cannot price a size out for good (it is never measured otherwise)
+    for (int u = 0; u < 8; ++u) {
+        if (n_t_[u] >= 3) continue;
+        int lo1 = -1, lo2 = -1, hi = -1;
+        for (int v = 0; v < u; ++v) if (n_t_[v] >= 3) { lo2 = lo1; lo1 = v; }
+        for (int v = 7; v > u; --v) if (n_t_[v] >= 3) hi = v;
+        int a, b;
+        if (lo1 >= 0 && hi >= 0) { a = lo1; b = hi; }
+        else if (lo2 >= 0) { a = lo2; b = lo1; }
+        else continue;
+        double line = th_[(size_t) a] + (th_[(size_t) b] - th_[(size_t) a]) * (u - a) / (double) (b - a);
+        if (u > 0) line = std::max(line, th_[(size_t) u - 1]);
+        th_[(size_t) u] = std::min(th_[(size_t) u], line);
+    }
+}
+
+void JointGate::seed_costs(const double s_by_t[kTRows], double rho_mtp, double rho_lu, double unit) {
+    for (int t = 0; t < kTRows; ++t) th_[(size_t) t] = s_by_t[t];
+    th_[8] = std::max(0.0, rho_mtp); th_[9] = std::max(0.0, rho_lu);
+    scale_ = unit > 0 ? unit : 1.0;
+    for (int t = 0; t < kTRows; ++t) n_t_[(size_t) t] = 3;   // seeded rows count as measured (no prior clamps)
+}
+
+int JointGate::remaining(int max_new, int produced, int max_context, int pos) {
+    int rem = max_new - produced - 1;
+    if (max_context > 0) rem = std::min(rem, max_context - pos - 1);
+    return std::max(rem, 0);
+}
+
+void JointGate::lu_haz(int s, int match, int ag, double h[kD]) const {
+    const int mb = mbucket(match);
+    for (int j = 0; j < kD; ++j) {
+        const int jb = std::min(j, 2);
+        h[j] = hl_s_[s][mb][ag][jb] / (hl_s_[s][mb][ag][jb] + hl_f_[s][mb][ag][jb]);
+    }
+}
+
+void JointGate::mtp_haz(const float* p, int n, double h[kD]) const {
+    for (int j = 0; j < kD; ++j) {
+        if (j < n || n > 0) {
+            const int b = pbucket((double) p[j < n ? j : n - 1]);
+            h[j] = hm_s_[j][b] / (hm_s_[j][b] + hm_f_[j][b]);
+        } else {
+            h[j] = hmm_s_[j] / (hmm_s_[j] + hmm_f_[j]);
+        }
+    }
+}
+
+int JointGate::expect(const double h[kD], int kmax, double e[kD + 1]) {
+    double acc = 1.0, surv = 1.0;
+    e[0] = 1.0;
+    for (int j = 0; j < kmax; ++j) { surv *= h[j]; acc += surv; e[j + 1] = acc; }
+    return kmax + 1;
+}
+
+bool JointGate::best_lookup(const Lookup lu[kSrc], int d, bool ag_known, double lam, int rem, double* v, int* s,
+                            int* t) const {
+    bool any = false;
+    for (int si = 0; si < kSrc; ++si) {
+        if (!o_.use_src[si] || lu[si].k <= 0) continue;
+        const int ag = !ag_known ? 2 : (lu[si].agree >= 1 ? 1 : 0);
+        double h[kD], e[kD + 1];
+        lu_haz(si, lu[si].match, ag, h);
+        const int ne = expect(h, std::min({lu[si].k, o_.tmax - 1, rem, kD}), e);
+        for (int k = 1; k < ne; ++k) {
+            const double val = e[k] - lam * cost_pred(k + 1, d, klu_);
+            if (!any || val > *v) { *v = val; *s = si; *t = k + 1; any = true; }
+        }
+    }
+    return any;
+}
+
+bool JointGate::start(const Lookup lu[kSrc], int rem, Choice* out) {
+    rem_ = rem;
+    klu_ = 0;
+    for (int si = 0; si < kSrc; ++si) if (o_.use_src[si]) klu_ += lu[si].k;
+    const double lam = lambda();
+    const double v0 = 1.0 - lam * cost_pred(1, 0, klu_);
+    double vl = 0; int sl = 0, tl = 1;
+    const bool bl = best_lookup(lu, 0, false, lam, rem, &vl, &sl, &tl);
+    *out = Choice{kNone, 1, 0, klu_};
+    if (!o_.mtp || rem <= 0) {
+        if (bl && vl > v0) *out = Choice{sl == 0 ? kLookup : kPool, tl, 0, klu_};
+        return true;
+    }
+    double hm[kD], em[kD + 1];
+    mtp_haz(nullptr, 0, hm);
+    const int ne = expect(hm, std::min({o_.tmax - 1, rem, kD}), em);   // tmax clamped to kD + 1 in the constructor
+    double vm = -1e300;
+    for (int k = 1; k < ne; ++k) vm = std::max(vm, em[k] - lam * cost_pred(k + 1, k, klu_));
+    if (o_.skip && bl && vl >= vm && vl > v0) {
+        *out = Choice{sl == 0 ? kLookup : kPool, tl, 0, klu_};
+        return true;
+    }
+    kmax_ = std::min({kD, o_.tmax - 1, rem});
+    return false;
+}
+
+bool JointGate::keep(const float* p, const float* ent, int d) {
+    if (o_.conf_stop) {
+        double H = ent != nullptr ? (double) ent[d - 1] : NAN;
+        if (std::isnan(H)) H = -std::log(std::max(1e-6, (double) p[d - 1]));
+        return !(1 - std::sqrt(o_.gamma * H) < o_.eta) && d < kmax_;
+    }
+    if (d >= kmax_) return false;
+    const double lam = lambda();
+    double h[kD], e[kD + 1];
+    mtp_haz(p, d, h);
+    expect(h, kmax_, e);
+    double now = -1e300, ahead = -1e300;
+    for (int k = 0; k <= d; ++k) now = std::max(now, e[k] - lam * cost_pred(k + 1, d, klu_));
+    for (int k = d + 1; k <= kmax_; ++k) ahead = std::max(ahead, e[k] - lam * cost_pred(k + 1, k, klu_));
+    return ahead > now;
+}
+
+JointGate::Choice JointGate::finish(const float* p, int d, const Lookup lu[kSrc]) {
+    const double lam = lambda();
+    double h[kD], e[kD + 1];
+    mtp_haz(p, d, h);
+    expect(h, d, e);
+    Choice best{kNone, 1, d, klu_};
+    double bv = -1e300;
+    bool first = true;
+    for (int k = 1; k <= d; ++k) {
+        const double v = e[k] - lam * cost_pred(k + 1, d, klu_);
+        if (first || v > bv) { bv = v; best = Choice{kMtp, k + 1, d, klu_}; first = false; }
+    }
+    const double vn = 1.0 - lam * cost_pred(1, d, klu_);
+    if (first || vn > bv) { bv = vn; best = Choice{kNone, 1, d, klu_}; }
+    double vl = 0; int sl = 0, tl = 1;
+    if (best_lookup(lu, d, true, lam, rem_, &vl, &sl, &tl) && vl > bv) best = Choice{sl == 0 ? kLookup : kPool, tl, d, klu_};
+    return best;
+}
+
+void JointGate::observe(const Choice& c, int a, double cost, int mtp_acc, const float* mtp_p, const Lookup lu[kSrc],
+                        const int lu_acc[kSrc]) {
+    cost_update(c.t, c.d, c.klu, cost);
+    lam_n_ = 0.995 * lam_n_ + (a + 1);
+    lam_c_ = 0.995 * lam_c_ + cost;
+    if (c.d > 0) {
+        int obs; bool fail;
+        censored(mtp_acc, c.d, a, &obs, &fail);
+        for (int j = 0; j < std::min({obs + (fail ? 1 : 0), c.d, kD}); ++j) {   // c.d > kD: no row
+            const int b = pbucket((double) mtp_p[j]);
+            const bool ok = j < obs;
+            hm_s_[j][b] += ok; hm_f_[j][b] += !ok;
+            hmm_s_[j] = 0.999 * hmm_s_[j] + ok; hmm_f_[j] = 0.999 * hmm_f_[j] + !ok;
+        }
+    }
+    for (int si = 0; si < kSrc; ++si) {
+        if (!o_.use_src[si] || lu[si].k <= 0) continue;
+        const int mb = mbucket(lu[si].match);
+        int obs; bool fail;
+        censored(lu_acc[si], std::min(lu[si].k, kD), a, &obs, &fail);
+        int ags[2] = {2, lu[si].agree >= 1 ? 1 : 0};
+        const int nag = c.d > 0 ? 2 : 1;
+        for (int g = 0; g < nag; ++g)
+            for (int j = 0; j < std::min(obs + (fail ? 1 : 0), lu[si].k); ++j) {
+                const bool ok = j < obs;
+                const int jb = std::min(j, 2);
+                hl_s_[si][mb][ags[g]][jb] = 0.998 * hl_s_[si][mb][ags[g]][jb] + ok;
+                hl_f_[si][mb][ags[g]][jb] = 0.998 * hl_f_[si][mb][ags[g]][jb] + !ok;
+            }
+    }
+}
+
+}  // namespace strata::spec
